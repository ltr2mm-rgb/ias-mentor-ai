<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIVORA · Mission Control (Live)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F8F4EC; --bg2:#F4ECDD; --card:#FFFFFF; --card2:#FBF7EF;
  --gold:#B8892E; --gold-soft:#D9B24A; --gold-hi:#D4AF37; --gold-deep:#8A6420;
  --burgundy:#7A1F1F; --burgundy-deep:#5a1414;
  --text:#1E1E1E; --muted:#5F5F5F; --line:#E8DDC6; --success:#1f9d57;
  --radius:24px;
  --brandimg:url("data:image/png;base64,");
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:#23201A;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Sora',sans-serif}
.brand-logo{display:inline-block;height:34px;width:159px;background:var(--brandimg) left center/contain no-repeat}
.app{display:grid;grid-template-columns:236px 1fr;min-height:100vh}
/* sidebar */
.side{background:linear-gradient(180deg,#FFFDF9,#F7EFDF);border-right:1px solid var(--line);padding:22px 16px;display:flex;flex-direction:column;gap:6px;position:sticky;top:0;height:100vh}
.side .logo{margin:2px 6px 20px}
.nav a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:11px;color:#5A5344;font-weight:600;font-size:.9rem;text-decoration:none;cursor:pointer}
.nav a .i{width:18px;text-align:center}
.nav a:hover{background:#F2E7D0}
.nav a.on{background:linear-gradient(135deg,var(--gold),var(--gold-deep));color:#fff;box-shadow:0 8px 20px rgba(184,137,46,.28)}
.side .uf{margin-top:auto;display:flex;align-items:center;gap:10px;padding:11px;border-radius:12px;background:#FBF5EA;border:1px solid var(--line)}
.side .uf .av{width:34px;height:34px;border-radius:50%;background:radial-gradient(circle at 32% 30%,var(--gold-soft),var(--gold-deep));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}
.side .uf small{color:#8A8069}
/* main */
.main{padding:24px 30px 60px;max-width:1180px}
.top{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px}
.top h1{font-size:1.5rem;font-weight:700}
.top .sub{color:#6B6355;font-size:.9rem;margin-top:2px}
.pills{display:flex;gap:8px;align-items:center}
.pill{display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:999px;font-size:.78rem;font-weight:700;border:1px solid var(--line);background:#fff}
.pill.live{color:#1f9d57;border-color:#bfe6cd;background:#f1faf4}
.dot{width:8px;height:8px;border-radius:50%;background:#1f9d57;box-shadow:0 0 0 0 rgba(31,157,87,.5);animation:pulse 1.8s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(31,157,87,.5)}70%{box-shadow:0 0 0 7px rgba(31,157,87,0)}100%{box-shadow:0 0 0 0 rgba(31,157,87,0)}}
.pill.stage{color:var(--gold-deep);background:#FBF2DD;border-color:#EBD9AE}
/* coach */
.coach{display:flex;gap:14px;align-items:flex-start;background:linear-gradient(120deg,#FBF4E6,#F6ECD7);border:1px solid #EAD9B3;border-radius:16px;padding:16px 18px;margin-bottom:18px}
.coach .ci{width:40px;height:40px;flex:none;border-radius:11px;background:linear-gradient(135deg,var(--gold),var(--gold-deep));display:flex;align-items:center;justify-content:center;font-size:1.2rem}
.coach .lbl{font-size:.68rem;letter-spacing:.14em;font-weight:800;color:var(--gold-deep);text-transform:uppercase}
.coach #coachtxt{margin-top:3px;font-size:.95rem;line-height:1.5;color:#4A4436}
.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:start}
@media(max-width:900px){.app{grid-template-columns:1fr}.side{display:none}.grid{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 18px 20px;box-shadow:0 1px 0 rgba(0,0,0,.02)}
.card h3{font-size:1.02rem;font-weight:700;display:flex;align-items:center;gap:8px}
.muted{color:#8A8069;font-size:.82rem}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0 4px}
.chip{font-size:.72rem;font-weight:700;padding:5px 10px;border-radius:999px;background:#F3EAD8;color:#7A6A45;border:1px solid #E7D6AE}
.q{font-size:1.06rem;font-weight:600;line-height:1.5;margin:12px 0 14px;color:#2C281F}
.opts{display:flex;flex-direction:column;gap:9px}
.opt{display:flex;gap:11px;align-items:center;padding:13px 14px;border:1.5px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;font-weight:500;font-size:.95rem;transition:.15s;text-align:left}
.opt:hover{border-color:var(--gold-soft);background:#FFFDF7}
.opt .k{width:24px;height:24px;flex:none;border-radius:7px;background:#F1E7D3;color:#8A6420;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:.82rem}
.opt.correct{border-color:#1f9d57;background:#f1faf4}
.opt.correct .k{background:#1f9d57;color:#fff}
.opt.wrong{border-color:#c0492f;background:#fcf2ef}
.opt.wrong .k{background:#c0492f;color:#fff}
.opt.dim{opacity:.5}
.opt[disabled]{cursor:default}
.fb{margin-top:12px;font-size:.9rem;font-weight:600;min-height:20px}
.fb.ok{color:#1f9d57}.fb.no{color:#c0492f}
.hint{margin-top:12px;font-size:.8rem;color:#9a8f77;display:flex;align-items:center;gap:6px}
/* readiness hero */
.hero{background:linear-gradient(150deg,#241d10,#3a2c12 60%,#4a3714);color:#F6ECD6;border:none;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;inset:0;background:radial-gradient(600px 200px at 80% -10%,rgba(212,175,55,.22),transparent)}
.hero h3{color:#F6ECD6}
.hero .lbl{font-size:.68rem;letter-spacing:.14em;font-weight:800;color:#D9B24A;text-transform:uppercase;position:relative}
.rd{display:flex;align-items:flex-end;gap:12px;margin-top:6px;position:relative}
.rd .big{font-family:'Sora';font-size:3.3rem;font-weight:800;line-height:1;background:linear-gradient(180deg,#F4D98B,#C89A34);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.deltaChip{font-size:.82rem;font-weight:800;padding:4px 9px;border-radius:999px;margin-bottom:8px;opacity:0;transition:.3s}
.deltaChip.up{background:rgba(31,157,87,.2);color:#7ee3a6}
.deltaChip.down{background:rgba(192,73,47,.22);color:#f0a58f}
.deltaChip.show{opacity:1}
.stab{margin-top:14px;position:relative}
.stab .row{display:flex;justify-content:space-between;font-size:.76rem;color:#D9C9A6;margin-bottom:5px}
.stab .track{height:7px;border-radius:6px;background:rgba(255,255,255,.13);overflow:hidden}
.stab .fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--gold-soft),var(--gold-hi));transition:width .7s cubic-bezier(.2,.8,.2,1)}
.why{margin-top:14px;font-size:.86rem;line-height:1.5;color:#EAD9AE;position:relative;border-top:1px solid rgba(255,255,255,.1);padding-top:12px}
.why b{color:#F4D98B}
/* dims */
.dim{margin-top:14px}
.dim:first-of-type{margin-top:8px}
.dim .row{display:flex;justify-content:space-between;align-items:baseline;font-size:.86rem;font-weight:600;margin-bottom:5px}
.dim .val{font-family:'Sora';font-weight:700}
.dim .src{font-size:.64rem;color:#B3A88E;font-weight:600;margin-left:6px}
.track{height:9px;border-radius:6px;background:#EEE4D0;overflow:hidden}
.fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--gold-soft),var(--gold));transition:width .8s cubic-bezier(.2,.8,.2,1)}
.flash{animation:flash 1.1s ease}
@keyframes flash{0%{background:#FFF6DE}40%{background:#FFF0C6}100%{background:transparent}}
.decision{background:linear-gradient(125deg,#1c2a1d,#26331e);border:none;color:#e9f3e2}
.decision h3{color:#eafff0}
.act{font-family:'Sora';font-size:1.12rem;font-weight:700;margin-top:8px;color:#bfe6cd}
.act b{color:#eafff0}
.decision .rsn{color:#c3d4bc;font-size:.87rem;line-height:1.55;margin-top:8px}
.decision .alt{margin-top:11px;font-size:.8rem;color:#9fb79a;border-top:1px solid rgba(255,255,255,.12);padding-top:9px}
.msteps{list-style:none;margin:13px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
.msteps li{display:flex;align-items:center;gap:9px;font-size:.86rem;color:#dce8d5;padding:8px 11px;background:rgba(255,255,255,.05);border-radius:9px}
.msteps .sk{font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:#8FCEA6;background:rgba(143,206,166,.14);padding:3px 7px;border-radius:6px;flex:none}
.msteps .est{margin-left:auto;color:#9fb79a;font-size:.76rem;font-weight:700}
.mentorbadge{display:inline-block;margin-top:10px;font-size:.72rem;font-weight:800;background:rgba(212,175,55,.18);color:#F4D98B;padding:4px 11px;border-radius:999px}
.leverbox{display:flex;align-items:center;gap:11px;margin-top:6px;padding:12px 14px;border-radius:12px;background:linear-gradient(120deg,#FBF2DD,#F6E9CC);border:1px solid #EBD9AE}
.leverbox .ic{font-size:1.3rem}
.leverbox .lk{font-family:'Sora';font-weight:700;color:var(--gold-deep)}
.revrow{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px dashed var(--line)}
.revrow:last-child{border-bottom:none}
.due{font-size:.74rem;font-weight:800;padding:4px 10px;border-radius:999px}
.due.today{background:#fcebe7;color:#c0492f}
.due.soon{background:#fdf3df;color:#a9791f}
.due.safe{background:#eef7f0;color:#1f9d57}
.toast{position:fixed;right:24px;bottom:24px;background:#241d10;color:#F6ECD6;padding:13px 18px;border-radius:13px;box-shadow:0 20px 50px rgba(0,0,0,.3);font-size:.9rem;font-weight:600;opacity:0;transform:translateY(14px);transition:.35s;z-index:60;max-width:340px;border:1px solid rgba(212,175,55,.3)}
.toast.show{opacity:1;transform:translateY(0)}
.toast b{color:#F4D98B}
.contract{margin-top:22px;font-size:.74rem;color:#9a8f77;line-height:1.6;border-top:1px solid var(--line);padding-top:14px}
.contract code{background:#F3EAD8;padding:1px 6px;border-radius:5px;color:#7a6a45;font-size:.72rem}

/* ===== Unified top header (matches homepage) ===== */
.uhnav{position:sticky;top:0;z-index:60;background:rgba(248,244,236,.90);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.uhnav-in{max-width:1220px;margin:0 auto;padding:11px 26px;display:flex;align-items:center;gap:24px}
.uhnav .brand-logo{height:34px;width:159px}
.uh-links{display:flex;gap:22px;flex:1;margin-left:6px}
.uh-links a{color:#6B6257;text-decoration:none;font-size:.92rem;font-weight:600;transition:.18s;cursor:pointer}
.uh-links a:hover{color:var(--gold-deep)}
.uh-links a.on{color:var(--gold-deep);font-weight:700}
.uh-links a.marga{background:linear-gradient(135deg,rgba(184,137,46,.15),rgba(212,175,55,.06));border:1px solid #EBD9AE;border-radius:9px;padding:6px 12px}
.marga-star{color:var(--gold);font-size:.78rem}
/* embed mode: when mounted as a workspace iframe inside /learn, the app shell
   supplies the header, so hide this page's own top nav */
.embed .uhnav{display:none}
.embed .wrap{padding-top:22px}
.uh-right{display:flex;align-items:center;gap:12px}
.uh-bell{position:relative;background:none;border:1px solid var(--line);width:38px;height:38px;border-radius:11px;cursor:pointer;font-size:1rem;display:inline-flex;align-items:center;justify-content:center;color:#23201A;transition:.18s}
.uh-bell:hover{background:rgba(184,137,46,.10);border-color:var(--gold)}
.uh-user{display:flex;align-items:center;gap:.5rem;background:none;border:1px solid var(--line);border-radius:11px;padding:.32rem .66rem .32rem .38rem;cursor:pointer;font-weight:600;font-size:.9rem;color:#23201A;position:relative}
.uh-user:hover{background:rgba(184,137,46,.08);border-color:var(--gold)}
.uh-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold-deep));color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:.82rem}
.uh-user .cx{font-size:.55rem;opacity:.6}
.uh-drop{position:absolute;top:calc(100% + 8px);right:0;min-width:210px;background:#FFFDF8;border:1px solid var(--line);border-radius:14px;box-shadow:0 22px 54px rgba(74,50,10,.16);padding:6px;display:none;z-index:80}
.uh-user.open .uh-drop{display:block}
.uh-drop a{display:flex;align-items:center;gap:.6rem;padding:.55rem .7rem;border-radius:9px;color:#23201A;text-decoration:none;font-size:.9rem;font-weight:500}
.uh-drop a:hover{background:rgba(184,137,46,.10);color:var(--gold-deep)}
@media(max-width:820px){.uh-links{display:none}}
/* ===== page shell ===== */
.wrap{max-width:1180px;margin:0 auto;padding:26px 26px 70px}
.top{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:14px}
.top h1{font-size:1.6rem;font-weight:800}
.top .sub{color:#6B6355;font-size:.92rem;margin-top:3px;max-width:520px}
.hstats{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.hstat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:9px 16px;min-width:104px;text-align:center}
.hstat .hv{font-family:'Sora';font-weight:800;font-size:1.5rem;color:var(--gold-deep);line-height:1.1}
.hstat .hl{font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800;color:#9a8f77;margin-top:3px}
.hstat.ready .hv{background:linear-gradient(180deg,var(--gold-hi),var(--gold-deep));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
/* mission hero (largest) */
.mission-hero{background:linear-gradient(125deg,#1c2a1d,#26331e);border:none;color:#e9f3e2;border-radius:20px;padding:26px 28px;margin-bottom:18px;position:relative;overflow:hidden}
.mission-hero:before{content:"";position:absolute;inset:0;background:radial-gradient(600px 220px at 88% -20%,rgba(212,175,55,.18),transparent)}
.mh-tag{font-size:.68rem;letter-spacing:.14em;font-weight:800;color:#8FCEA6;text-transform:uppercase;position:relative}
.mh-title{font-family:'Sora';font-size:1.55rem;font-weight:800;color:#eafff0;margin-top:8px;position:relative}
.mh-reason{color:#c3d4bc;font-size:.92rem;line-height:1.55;margin-top:8px;position:relative;max-width:660px}
.mh-gain{align-items:center;gap:8px;margin-top:14px;background:rgba(212,175,55,.16);color:#F4D98B;font-weight:800;font-size:.82rem;padding:7px 13px;border-radius:999px;position:relative}
.mh-start{margin-top:16px;display:inline-flex;align-items:center;gap:9px;background:linear-gradient(135deg,var(--gold-soft),var(--gold-deep));color:#241d10;font-family:'Sora';font-weight:800;font-size:1rem;border:none;border-radius:13px;padding:13px 26px;cursor:pointer;box-shadow:0 12px 30px rgba(212,175,55,.30);transition:.18s;position:relative}
.mh-start:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(212,175,55,.42)}
.mh-alt{margin-top:13px;font-size:.8rem;color:#9fb79a;position:relative}
.mission-hero .msteps li{color:#dce8d5}
/* two-column body */
.mgrid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;align-items:start}
@media(max-width:900px){.mgrid{grid-template-columns:1fr}}
.col{display:flex;flex-direction:column;gap:18px}
#whyline{margin-top:8px;font-size:.92rem;line-height:1.6;color:#4A4436}
#whyline b{color:var(--gold-deep)}
/* Mission Control hides engine-internal source/version tags (per spec) */
#dims .src{display:none}
/* recent progress timeline */
.tl{list-style:none;margin:10px 0 0;padding:0}
.tl li{display:flex;gap:12px;align-items:center;padding:9px 0;border-bottom:1px dashed var(--line);font-size:.88rem;color:#4A4436}
.tl li:last-child{border-bottom:none}
.tl .td{font-weight:700;color:#8A6420;min-width:74px}
.tl .tg{margin-left:auto;font-weight:800;font-size:.82rem}
.tl .tg.up{color:#1f9d57}.tl .tg.down{color:#c0492f}
/* mentor compact */
.mentor{display:flex;gap:13px;align-items:flex-start;background:linear-gradient(120deg,#FBF4E6,#F6ECD7);border:1px solid #EAD9B3;border-radius:16px;padding:16px 18px}
.mentor .mi{width:40px;height:40px;flex:none;border-radius:11px;background:linear-gradient(135deg,var(--gold),var(--gold-deep));display:flex;align-items:center;justify-content:center;font-size:1.2rem}
.mentor .ask{margin-top:10px;display:flex;gap:8px}
.mentor .ask input{flex:1;border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-family:inherit;font-size:.88rem;background:#fff}
.mentor .ask button{border:none;background:linear-gradient(135deg,var(--gold),var(--gold-deep));color:#fff;font-weight:700;border-radius:10px;padding:9px 15px;cursor:pointer}

</style>
</head>
<body>
<!-- ===== Unified top header (shared with homepage) ===== -->
<nav class="uhnav"><div class="uhnav-in">
  <a href="/"><span class="brand-logo" aria-label="AIVORA"></span></a>
  <div class="uh-links">
    <a href="/">Home</a>
    <a class="on marga" href="/mission-control" title="Your command center"><span class="marga-star">★</span> AIVORA</a>
    <a href="/learn">Learn through MCQs</a>
    <a href="/learn">Self Preparation</a>
    <a href="/learn">Track &amp; Improve</a>
    <a href="/learn">Study &amp; Notes</a>
  </div>
  <div class="uh-right">
    <button class="uh-bell" title="Today's mission" onclick="startMission()">🔔</button>
    <div class="uh-user" id="uhuser" onclick="this.classList.toggle('open');event.stopPropagation()">
      <span class="uh-avatar">M</span><span>Mahesha M</span><span class="cx">▾</span>
      <div class="uh-drop">
        <a href="/learn">👤 My Profile</a>
        <a href="/learn">📈 Progress</a>
        <a href="/learn">⚙️ Settings</a>
        <a href="#" onclick="uhLogout(event)">↩️ Logout</a>
      </div>
    </div>
  </div>
</div></nav>

<div class="wrap">
  <!-- HEADER BAND: greeting + Readiness % + Today's Mission time + Stage -->
  <div class="top">
    <div>
      <h1>Good morning, Mahesha 👋</h1>
      <div class="sub">Here is exactly what to do next — and why it moves your readiness the most.</div>
    </div>
    <div class="hstats">
      <div class="hstat ready"><div class="hv" id="readiness">—</div><div class="hl">Readiness</div></div>
      <div class="hstat"><div class="hv" id="hdr-min">~— min</div><div class="hl">Today's Mission</div></div>
      <span class="pill stage" id="stagepill">Stage · —</span>
    </div>
  </div>
  <!-- forecast confidence strip -->
  <div style="display:flex;align-items:center;gap:14px;margin:0 0 20px;font-size:.78rem;color:#8A8069">
    <span id="conflabel">Confidence —</span>
    <div style="flex:1;max-width:240px"><div class="track" style="height:7px"><div class="fill" id="stabfill" style="width:0%"></div></div></div>
    <span id="stablabel">Stability —</span>
    <span class="deltaChip" id="rdelta"></span>
  </div>

  <!-- 1. TODAY'S MISSION (largest) -->
  <section class="mission-hero">
    <div class="mh-tag">🧭 Today's Mission · your highest-gain next step</div>
    <div class="mh-title" id="actionline">—</div>
    <div class="mh-reason" id="actionreason">Loading your personalised mission…</div>
    <ol class="msteps" id="missionsteps"></ol>
    <div class="mh-gain" id="mgain" style="display:none"></div>
    <div><button class="mh-start" id="mh-mission-btn" onclick="missionAction()">🚀 Start Mission</button></div>
    <div class="mh-alt" id="actionalt"></div>
  </section>

  <div class="mgrid">
    <div class="col">
      <!-- 2. WHY THIS MISSION -->
      <section class="card">
        <h3>💡 Why this mission?</h3>
        <div id="whyline">Answer a question and the engine will explain what is moving your readiness.</div>
      </section>
      <!-- 3. LEARNING HEALTH -->
      <section class="card">
        <h3>📊 Learning Health</h3>
        <div id="dims"></div>
      </section>
      <!-- 5. RECENT PROGRESS -->
      <section class="card">
        <h3>📈 Recent Progress</h3>
        <ul class="tl" id="timeline"></ul>
      </section>
    </div>
    <div class="col">
      <!-- 4. GROWTH LEVER -->
      <section class="card">
        <h3>⚡ Today's Focus</h3>
        <div class="leverbox"><span class="ic">🎯</span><div><div class="lk" id="leverkey">—</div><div class="muted" id="leverwhy">The one dimension expected to move readiness most.</div></div></div>
      </section>
      <!-- 6. AI MENTOR (compact) -->
      <section class="mentor">
        <div class="mi">🧠</div>
        <div style="flex:1">
          <div style="font-size:.68rem;letter-spacing:.14em;font-weight:800;color:var(--gold-deep);text-transform:uppercase">AI Mentor</div>
          <div id="coachtxt" style="margin-top:3px;font-size:.92rem;line-height:1.5;color:#4A4436">Ask me about your plan, a concept, or why today's mission was chosen.</div>
          <div class="ask"><input id="mentorq" placeholder="Ask your mentor…" onkeydown="if(event.key==='Enter')mentorAsk()"><button onclick="mentorAsk()">Ask</button></div>
          <div class="muted" style="margin-top:8px"><span id="qcount">0</span> answered today</div>
        </div>
      </section>
      <!-- 7. UPCOMING REVIEWS -->
      <section class="card">
        <h3>🔁 Upcoming Reviews</h3>
        <div id="revision"></div>
      </section>
    </div>
  </div>

  <!-- practice (revealed by Start Mission) -->
  <section class="card" id="practicecard" style="display:none;margin-top:18px">
    <h3>🎯 Your Mission — in progress <span class="muted" style="font-weight:500">· live</span></h3>
    <div class="chips">
      <span class="chip" id="c-concept">—</span>
      <span class="chip" id="c-pattern">—</span>
      <span class="chip" id="c-diff">—</span>
    </div>
    <div class="q" id="qtext">—</div>
    <div class="opts" id="opts"></div>
    <div class="fb" id="fb"></div>
    <div class="hint">✦ <span id="hinttxt">Each answer updates your Knowledge, Readiness, Growth Lever and revision schedule in real time.</span></div>
  </section>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================================
   Client mirror of the verified backend pipeline (learner_kernel /
   prediction_engine / state_delta / explanation_service). Same formulas, so the
   numbers move exactly as the server would move them. render(payload) consumes
   the real /me/attempt contract — see applyAnswer().
   ========================================================================== */
const COVERAGE = 58;                         // syllabus coverage % (constant in demo)
const TARGETS = {knowledge:70,retention:70,exam_skills:65,confidence:70};
const WEIGHTS = {exam_skills:1.3,retention:1.2,knowledge:1.0,confidence:1.0};
const DIM_LABEL = {knowledge:'Knowledge',retention:'Retention (memory)',exam_skills:'Exam skills',confidence:'Confidence'};
const SRC = {knowledge:'knowledge-v1.3',retention:'retention-v1.3',exam_skills:'exam-skills-v1.3',confidence:'confidence-v1.3'};

// ---- seed evidence (per-concept + per-pattern mastery) ----
const concepts = {
  parliament:{name:'Parliament',mastery:0.62,attempts:30,lastDays:1},
  federalism:{name:'Federalism',mastery:0.80,attempts:18,lastDays:7},
  dpsp:{name:'Directive Principles',mastery:0.55,attempts:12,lastDays:11},
};
const skills = {
  statement_based:{mastery:0.60,attempts:30},
  elimination:{mastery:0.70,attempts:20},
  assertion_reason:{mastery:0.52,attempts:10},
};
let recent = [1,1,0,1,1,0,1,1,0,1];          // rolling correctness (recent_acc)
let confTally = {tagged:24, sureWrong:5};    // confidence calibration seed
let answered = 0;

// ---- faithful mastery update (mirrors main.py _aml_update_mastery) ----
function difficultyGain(d,correct){d=(d||'medium').toLowerCase();
  return (correct?{easy:.6,medium:1,hard:1.4}:{easy:1.4,medium:1,hard:.6})[d]??1;}
function updateMastery(old,correct,difficulty,confidence,base=.25){
  old=old==null?.5:old; let a=base*difficultyGain(difficulty,correct);
  if(!correct){if(confidence==='sure')a*=1.3;else if(confidence==='guess')a*=0.7;}
  const t=correct?1:0; return Math.max(0,Math.min(1,old+a*(t-old)));
}
// ---- kernel reducers (mirror learner_kernel) ----
function conf_(n){return n?Math.min(.9,Math.round((0.2+(n/200)*0.7)*100)/100):0;}
function retention_(m,days){if(days==null)return m;const hl=7+m*0.21;return Math.max(0,Math.round(m*Math.pow(0.5,Math.max(0,days)/hl)));}
function wmean(pairs){let n=0,s=0;pairs.forEach(([v,w])=>{s+=v*w;n+=w;});return n?s/n:null;}
function recentAcc(){return recent.length?Math.round(100*recent.reduce((a,b)=>a+b,0)/recent.length):0;}
function computeState(){
  const cs=Object.values(concepts);
  const know=wmean(cs.filter(c=>c.attempts>=1).map(c=>[c.mastery*100,Math.min(c.attempts,40)]));
  const ret=wmean(cs.filter(c=>c.attempts>=3).map(c=>[retention_(c.mastery*100,c.lastDays),Math.min(c.attempts,40)]));
  const ss=Object.values(skills);
  const exam=ss.length?100*ss.reduce((a,s)=>a+s.mastery,0)/ss.length:null;
  const cf=confTally.tagged?100*(1-confTally.sureWrong/confTally.tagged):null;
  const totA=cs.reduce((a,c)=>a+c.attempts,0);
  const mk=(v,n,k)=>v==null?{value:'unknown',confidence:0,source:SRC[k]}:{value:Math.round(v),confidence:conf_(n),source:SRC[k]};
  return {knowledge:mk(know,totA,'knowledge'),retention:mk(ret,totA,'retention'),
          exam_skills:mk(exam,ss.reduce((a,s)=>a+s.attempts,0),'exam_skills'),
          confidence:mk(cf,confTally.tagged,'confidence')};
}
// ---- prediction (mirror prediction_engine) ----
function readinessValue(k,cov,acc){return Math.round(0.5*k+0.3*cov+0.2*acc);}
function stability(n,state){const vol=Math.min(1,(n||0)/150);
  const core=['knowledge','retention','exam_skills'];
  const meas=core.filter(k=>typeof state[k].value==='number').length/core.length;
  return Math.round((0.6*vol+0.4*meas)*100)/100;}
function confLabel(s){return s>=.75?'High':s>=.45?'Medium':'Low';}
function growthLever(state){let best=null,bd=0;
  for(const k in TARGETS){const v=state[k]&&state[k].value;if(typeof v!=='number')continue;
    const d=(WEIGHTS[k]||1)*Math.max(0,TARGETS[k]-v)/TARGETS[k];if(d>bd){bd=d;best=k;}}
  return {lever_key:best,drag:Math.round(bd*1000)/1000};}
// ---- decision engine (mirror decision_engine) ----
const RET_RISK=65,M_TARGET=70,EXAM_TARGET=65,ACT_LABEL={revise:'Revise',practise:'Practise',teach:'Learn',increase_difficulty:'Level up'};
function weakConcepts(){return Object.entries(concepts).map(([k,c])=>({name:c.name,key:k,
  retention:retention_(c.mastery*100,c.lastDays),mastery:Math.round(c.mastery*100)})).sort((a,b)=>a.retention-b.retention||a.mastery-b.mastery);}
function decide(state,lever,weak){const dimv=k=>(state[k]&&typeof state[k].value==='number')?state[k].value:null;
  const atRisk=weak.filter(c=>c.retention<RET_RISK);let primary,reason,alt=null;
  if(atRisk.length){const c=atRisk[0];primary={action:'revise',target:c.name};const know=dimv('knowledge');
    const kc=(know!=null&&know>=M_TARGET)?`Knowledge is already above target (${know}%), so revision recovers more readiness than new content today`:'recovering it protects the gains you’ve made';
    reason=`${c.name} retention (${c.retention}%) has fallen below the ${RET_RISK}% risk line and is predicted to keep dropping; ${kc}.`;}
  else if(lever){const t=weak[0]?weak[0].name:'your weakest area';const action=lever==='exam_skills'?'practise':(lever==='retention'?'revise':'teach');
    primary={action,target:t};const lv=dimv(lever);const tgt=lever==='exam_skills'?EXAM_TARGET:M_TARGET;
    reason=`Your Growth Lever is ${lever.replace('_',' ')}${lv!=null?` (${lv}%, below its ${tgt}% target)`:''}; ${({revise:'revise',practise:'practise',teach:'learn'})[action]} ${t} is the highest expected-gain move.`;}
  else{primary={action:'practise',target:weak[0]?weak[0].name:'a mixed set'};reason='All measured dimensions are near target — balanced practice keeps momentum.';}
  if(weak.length>1){const c2=weak[1];alt={action:c2.retention<RET_RISK?'revise':'practise',target:c2.name};}
  const conf=dimv('confidence');return {primary,alternative:alt,reason,mentor_intervene:(conf!=null&&conf<60)||atRisk.length>=2};}
function explainLever(k,state){if(!k)return 'All measured dimensions are near target — no single constraint right now.';
  const lab=DIM_LABEL[k]||k,v=(state[k]&&typeof state[k].value==='number')?state[k].value:null,tgt=TARGETS[k]||70;
  return v!=null?`${lab} sits ${tgt-v} pts below its ${tgt}% target (${v}%) — improving it lifts readiness most.`:`${lab} is your Growth Lever.`;}
function reviseWhy(ret){return ret<60?'Predicted to fall below 60% — revise today.':ret<75?'Retention decaying — revise tomorrow.':'Stable — light reinforcement.';}
// ---- mission planner (mirror mission_planner) ----
const M_RECIPES={
 revise:[['revise','Revise {t}',12],['practise','Recall check — 8 questions on {t}',10],['review','Review what you missed',6],['checkpoint','Confidence checkpoint',4]],
 teach:[['teach','Learn {t}',15],['example','Worked example',8],['practise','Practise — 6 questions on {t}',10],['checkpoint','Mini-check',5]],
 practise:[['warmup','Warm-up recall',4],['practise','Practise — 12 questions on {t}',16],['review','Review mistakes',7],['checkpoint','Checkpoint',4]],
 increase_difficulty:[['practise','Hard set on {t}',14],['review','Review mistakes',6],['checkpoint','Checkpoint',4]],
};
const M_TITLE={revise:'Revise {t} before it fades',teach:'Build {t} from the ground up',practise:'Sharpen {t}',increase_difficulty:'Level up on {t}'};
function planMission(decision){const p=(decision&&decision.primary)||{};const action=p.action||'practise';const t=p.target||'your weakest area';
 const rec=M_RECIPES[action]||M_RECIPES.practise;
 const steps=rec.map(([kind,title,est])=>({kind,title:title.replace('{t}',t),est_min:est}));
 return {title:(M_TITLE[action]||"Today's mission").replace('{t}',t),why:(decision||{}).reason,steps,est_total_min:steps.reduce((a,s)=>a+s.est_min,0)};}
// ---- state delta (mirror state_delta) ----
function snap(state,readiness,lever){const dims={};for(const k in state)if(typeof state[k].value==='number')dims[k]=state[k].value;
  return {dims,readiness,lever};}
function computeDelta(o,n){const dims={};
  for(const k in n.dims){const ov=o.dims[k];if(ov==null){dims[k]={old:null,new:n.dims[k],change:null};}
    else if(n.dims[k]!==ov)dims[k]={old:ov,new:n.dims[k],change:Math.round((n.dims[k]-ov)*10)/10};}
  let readiness=null;if(n.readiness!=null){const c=typeof o.readiness==='number'?Math.round((n.readiness-o.readiness)*10)/10:null;
    readiness={old:o.readiness,new:n.readiness,change:c};}
  return {dims,readiness,growth_lever_changed:!!(n.lever&&o.lever&&n.lever!==o.lever),growth_lever:{old:o.lever,new:n.lever}};}
// ---- explanation (mirror explanation_service) ----
function phrase(l,c){return `${l} ${c>0?'improved':'declined'} ${Math.abs(Math.round(c))} pt${Math.abs(Math.round(c))!==1?'s':''}`;}
function explain(delta){const r=delta.readiness||{};const ch=r.change,nv=r.new;
  const moved=Object.entries(delta.dims).filter(([,v])=>typeof v.change==='number'&&v.change!==0).sort((a,b)=>Math.abs(b[1].change)-Math.abs(a[1].change));
  const factors=moved.map(([k,v])=>({label:DIM_LABEL[k]||k,contribution:v.change,direction:v.change>0?'+':'-'}));
  let claim,message;
  if(ch==null){claim=nv!=null?`Readiness is ${nv}%.`:'Readiness updated.';message=claim;}
  else{const verb=ch>0?'rose':ch<0?'dropped':'held steady';
    claim=ch?`Readiness ${verb} ${Math.abs(Math.round(ch))} pts to ${nv}%`:`Readiness held steady at ${nv}%`;
    const reasons=factors.slice(0,2).map(f=>phrase(f.label,f.contribution));
    if(delta.growth_lever_changed){const g=delta.growth_lever;reasons.push(`your strongest constraint shifted from ${DIM_LABEL[g.old]||g.old} to ${DIM_LABEL[g.new]||g.new}`);}
    message=claim+(reasons.length?' because '+reasons.join(' and '):'.');}
  return {kind:'readiness_change',claim,message,factors};}

/* ---- questions ---- */
const QUESTIONS=[
 {concept:'parliament',pattern:'statement_based',difficulty:'medium',conf:'sure',
  q:'Which House is better placed to reflect sudden shifts in popular opinion?',
  opts:['Rajya Sabha','Lok Sabha','Both equally','Neither House'],ans:1},
 {concept:'federalism',pattern:'assertion_reason',difficulty:'hard',conf:'sure',
  q:'Residuary powers of legislation in India are vested in —',
  opts:['State legislatures','The Parliament','Concurrent List','Local bodies'],ans:1},
 {concept:'dpsp',pattern:'statement_based',difficulty:'medium',conf:'guess',
  q:'Directive Principles of State Policy are —',
  opts:['Justiciable','Non-justiciable','Fundamental Rights','Enforceable by courts'],ans:1},
 {concept:'parliament',pattern:'elimination',difficulty:'hard',conf:'sure',
  q:'A Money Bill can be introduced only in —',
  opts:['Rajya Sabha','Either House','Lok Sabha','A joint sitting'],ans:2},
 {concept:'federalism',pattern:'statement_based',difficulty:'medium',conf:'sure',
  q:'The power to form a new State by altering boundaries lies with —',
  opts:['The concerned State','Parliament','Supreme Court','President alone'],ans:1},
 {concept:'dpsp',pattern:'elimination',difficulty:'medium',conf:'sure',
  q:'Which is a Gandhian principle among the DPSP?',
  opts:['Uniform Civil Code','Promotion of cottage industries','Separation of judiciary','Equal pay'],ans:1},
];
let qi=0, oldSnap=null;

/* ---- rendering (consumes the /me/attempt contract) ---- */
const $=id=>document.getElementById(id);
function tween(el,from,to,ms){const t0=performance.now();(function step(t){const p=Math.min(1,(t-t0)/ms);
  el.textContent=Math.round(from+(to-from)*p)+'%';if(p<1)requestAnimationFrame(step);})(t0);}
function renderDims(state,delta){const box=$('dims');box.innerHTML='';
  ['knowledge','retention','exam_skills','confidence'].forEach(k=>{const d=state[k];const v=typeof d.value==='number'?d.value:0;
    const changed=delta&&delta.dims[k]&&typeof delta.dims[k].change==='number';
    const el=document.createElement('div');el.className='dim'+(changed?' flash':'');
    el.innerHTML=`<div class="row"><span>${DIM_LABEL[k]}<span class="src">${d.source}</span></span><span class="val">${typeof d.value==='number'?d.value+'%':'—'}</span></div>
      <div class="track"><div class="fill" style="width:${v}%"></div></div>`;
    box.appendChild(el);});}
function renderRevision(state){const box=$('revision');box.innerHTML='';
  const rows=Object.entries(concepts).map(([k,c])=>({name:c.name,ret:retention_(c.mastery*100,c.lastDays)})).sort((a,b)=>a.ret-b.ret);
  rows.forEach(r=>{const cls=r.ret<60?'today':r.ret<75?'soon':'safe';const due=r.ret<60?'Today':r.ret<75?'Tomorrow':'In 3 days';
    const el=document.createElement('div');el.className='revrow';
    el.innerHTML=`<div><div style="font-weight:600;font-size:.92rem">${r.name}</div><div class="muted">${reviseWhy(r.ret)}</div></div><span class="due ${cls}">${due}</span>`;
    box.appendChild(el);});}
function render(payload){
  const {profile,prediction,state_delta:delta,explanation:exp}=payload;
  const state=profile.current_state;
  // readiness (guarded for cold-start / null)
  const rv=(prediction&&typeof prediction.value==='number')?prediction.value:null;
  if(rv===null){$('readiness').textContent='—';}
  else{const prev=parseInt($('readiness').textContent);tween($('readiness'),isNaN(prev)?rv:prev,rv,650);}
  const stab=(prediction&&typeof prediction.stability==='number')?prediction.stability:0;
  $('conflabel').textContent='Confidence '+((prediction&&prediction.confidence_label)||'—');
  $('stablabel').textContent='Stability '+Math.round(stab*100)+'%';
  $('stabfill').style.width=Math.round(stab*100)+'%';
  // delta chip
  const rc=delta&&delta.readiness&&delta.readiness.change;
  const chip=$('rdelta');
  if(typeof rc==='number'&&rc!==0){chip.textContent=(rc>0?'▲ +':'▼ ')+rc;chip.className='deltaChip show '+(rc>0?'up':'down');}
  else{chip.className='deltaChip';}
  // why / explanation
  if(exp)$('whyline').innerHTML='<b>Why?</b> '+exp.message;
  $('coachtxt').textContent=exp?exp.message:$('coachtxt').textContent;
  // dims + stage
  renderDims(state,delta);
  $('stagepill').textContent='Stage · '+profile.stage;
  // growth lever (behavioral, threshold-based)
  const lk=profile.growth_lever&&profile.growth_lever.lever_key;
  $('leverkey').textContent=lk?DIM_LABEL[lk]||lk:'Balanced — no single constraint';
  $('leverwhy').textContent=explainLever(lk,state);
  if(delta&&delta.growth_lever_changed)$('leverkey').parentElement.parentElement.classList.add('flash');
  // decision → mission (Today's Mission)
  if(payload.mission){const m=payload.mission;const d=payload.decision||{};
    $('actionline').innerHTML=`<b>${m.title}</b> <span style="font-weight:500;color:#9fb79a;font-size:.8rem">· ~${m.est_total_min} min</span>`;
    $('actionreason').textContent=d.reason||m.why||'';
    const ol=$('missionsteps');ol.innerHTML='';
    m.steps.forEach(s=>{const li=document.createElement('li');li.innerHTML=`<span class="sk">${s.kind}</span> ${s.title} <span class="est">${s.est_min}m</span>`;ol.appendChild(li);});
    let altHtml=d.alternative?`Alternative — ${ACT_LABEL[d.alternative.action]||d.alternative.action} ${d.alternative.target}`:'';
    if(d.mentor_intervene)altHtml+=`<span class="mentorbadge">AI Mentor recommended</span>`;
    $('actionalt').innerHTML=altHtml;}
  // revision
  renderRevision(state);
  // toast
  if(exp&&typeof rc==='number'){const t=$('toast');t.innerHTML='<b>'+exp.claim+'</b>';t.classList.add('show');
    clearTimeout(window._tt);window._tt=setTimeout(()=>t.classList.remove('show'),2600);}
}
/* build the /me/attempt-shaped payload from the local engine */
function buildPayload(){const state=computeState();const totA=Object.values(concepts).reduce((a,c)=>a+c.attempts,0);
  const rv=readinessValue(typeof state.knowledge.value==='number'?state.knowledge.value:recentAcc(),COVERAGE,recentAcc());
  const stab=stability(totA,state);const lever=growthLever(state);
  const newSnap=snap(state,rv,lever.lever_key);
  const delta=oldSnap?computeDelta(oldSnap,newSnap):{dims:{},readiness:{old:null,new:rv,change:null},growth_lever_changed:false,growth_lever:{old:null,new:lever.lever_key}};
  const exp=explain(delta);oldSnap=newSnap;
  const gl=lever.lever_key?{lever_key:lever.lever_key,drag:lever.drag}:{lever_key:null};
  const weak=weakConcepts();const decision=decide(state,lever.lever_key,weak);const mission=planMission(decision);
  return {profile:{current_state:state,stage:(typeof state.knowledge.value==='number'&&state.knowledge.value>=70)?'Advanced':(state.knowledge.value>=45?'Intermediate':'Foundation'),growth_lever:gl},
          prediction:{metric:'readiness',value:rv,confidence_label:confLabel(stab),stability:stab,horizon_days:14,engine_version:'readiness-v1.3'},
          state_delta:delta,explanation:exp,decision:decision,mission:mission,readiness_delta:delta.readiness?delta.readiness.change:null};
}
/* apply one answer → update evidence → render the resulting payload.
   (Swap the body for: const r=await fetch('/me/attempt',{...}); render(await r.json()); ) */
function applyAnswer(qq,correct){
  const c=concepts[qq.concept];c.mastery=updateMastery(c.mastery,correct,qq.difficulty,qq.conf);c.attempts++;c.lastDays=0;
  const s=skills[qq.pattern];if(s){s.mastery=updateMastery(s.mastery,correct,qq.difficulty,qq.conf);s.attempts++;}
  recent.push(correct?1:0);if(recent.length>20)recent.shift();
  confTally.tagged++;if(!correct&&qq.conf==='sure')confTally.sureWrong++;
  answered++;$('qcount').textContent=answered;
  render(buildPayload());
}
/* question UI */
function loadQuestion(){const qq=QUESTIONS[qi%QUESTIONS.length];
  $('c-concept').textContent=concepts[qq.concept].name;
  $('c-pattern').textContent=qq.pattern.replace('_','-');
  $('c-diff').textContent=qq.difficulty;
  $('qtext').textContent=qq.q;$('fb').textContent='';$('fb').className='fb';
  const box=$('opts');box.innerHTML='';
  qq.opts.forEach((o,i)=>{const b=document.createElement('button');b.className='opt';
    b.innerHTML=`<span class="k">${'ABCD'[i]}</span> ${o}`;
    b.onclick=()=>answer(qq,i,b);box.appendChild(b);});
}
function answer(qq,idx,btn){const correct=idx===qq.ans;
  [...$('opts').children].forEach((b,i)=>{b.disabled=true;if(i===qq.ans)b.classList.add('correct');
    else if(i===idx)b.classList.add('wrong');else b.classList.add('dim');});
  $('fb').textContent=correct?'Correct — mastery reinforced.':'Not quite — this becomes a targeted revision.';
  $('fb').className='fb '+(correct?'ok':'no');
  applyAnswer(qq,correct);
  qi++;setTimeout(loadQuestion,1500);
}
/* ============================================================================
   LIVE backend integration. On load, tries GET /me/profile with the learner's
   bearer token; if it succeeds, the screen shows REAL data and answering posts
   to /me/attempt. If there's no token / no backend / opened as a static file,
   it falls back to the offline demo engine above (identical behavior).
   ========================================================================== */
const API_BASE='';                 // same origin as the app (aimentora.in)
const TOKEN_KEYS=['ias_token','ias_admin_token','token','access_token','aivora_token','authToken','jwt'];
const QUESTION_YEAR='2023';        // PYQ year to source live questions from (small pool)
function getToken(){
  try{const u=new URLSearchParams(location.search).get('token'); if(u)return u;}catch(e){}
  if(window.__AIMARGA_TOKEN__)return window.__AIMARGA_TOKEN__;
  try{for(const k of TOKEN_KEYS){const v=(localStorage.getItem(k)||sessionStorage.getItem(k)); if(v)return v;}}catch(e){}
  return null;
}
function authHeaders(){const t=getToken();const h={'Content-Type':'application/json'};if(t)h['Authorization']='Bearer '+t;return h;}
async function api(path,opts){const r=await fetch(API_BASE+path,Object.assign({headers:authHeaders()},opts||{}));if(!r.ok)throw new Error(path+' '+r.status);return r.json();}
function normPred(p){if(!p)return {value:null,confidence_label:'—',stability:0,horizon_days:14};
  if(!p.confidence_label){const s=(typeof p.stability==='number')?p.stability:(p.confidence||0);p.confidence_label=s>=0.75?'High':s>=0.45?'Medium':'Low';}
  if(typeof p.stability!=='number')p.stability=(typeof p.confidence==='number')?p.confidence:0;return p;}
function profileToPayload(j){return {profile:{current_state:j.current_state||{},stage:j.stage,growth_lever:j.growth_lever||{}},
  prediction:normPred(j.prediction),decision:j.decision,mission:j.mission,state_delta:null,explanation:null,readiness_delta:null};}

let liveQ=[], lqi=0, qStart=0;
async function fetchLiveQuestions(){
  const j=await api('/pyq/practice/start',{method:'POST',body:JSON.stringify({exam:'gs',year:QUESTION_YEAR})});
  return (j.questions||j||[]).filter(q=>q&&q.id).slice(0,10);
}
function loadLiveQuestion(){
  const q=liveQ[lqi%liveQ.length]; if(!q)return;
  $('c-concept').textContent=q.topic||q.subject||'Practice';
  $('c-pattern').textContent=q.question_type||'mcq';
  $('c-diff').textContent=q.difficulty||'medium';
  $('qtext').textContent=q.text; $('fb').textContent=''; $('fb').className='fb';
  const box=$('opts'); box.innerHTML='';
  [q.option_a,q.option_b,q.option_c,q.option_d].forEach((o,i)=>{if(o==null)return;
    const b=document.createElement('button');b.className='opt';
    b.innerHTML=`<span class="k">${'ABCD'[i]}</span> ${o}`;b.onclick=()=>answerLive(q,i,box);box.appendChild(b);});
  qStart=performance.now();
}
async function answerLive(q,idx,box){
  const sel='ABCD'[idx]; const correct=sel===(q.correct_answer||'').toUpperCase();
  [...box.children].forEach((b,i)=>{b.disabled=true;const ok='ABCD'[i]===(q.correct_answer||'').toUpperCase();
    if(ok)b.classList.add('correct');else if(i===idx)b.classList.add('wrong');else b.classList.add('dim');});
  $('fb').textContent=correct?'Correct — mastery reinforced.':'Not quite — this becomes a targeted revision.';
  $('fb').className='fb '+(correct?'ok':'no');
  try{
    const resp=await api('/me/attempt',{method:'POST',body:JSON.stringify(
      {question_id:q.id,selected:sel,correct:correct,response_ms:Math.round(performance.now()-qStart),
       confidence:'somewhat',attempt_context:'practice'})});
    answered++; if($('qcount'))$('qcount').textContent=answered;
    try{ renderLearning(await api('/me/learning')); }catch(_e){}
    try{ if(window.__mission && window.__mission.state==='STARTED'){ await api('/me/mission/next',{method:'POST',body:'{}'}); } await renderMission(); }catch(_e){}
  }catch(e){console.error('attempt failed:',e.message);}
  lqi++; setTimeout(loadLiveQuestion,1500);
}
/* ── M3: Mission Control is a THIN consumer of GET /me/learning ───────────────
   It fetches the projection read-model and renders it. No mastery/readiness/
   growth-lever/scheduling logic here — those belong to the backend projection.
   Sorting for display is presentation only. */
function renderLearning(d){
  d=d||{};
  var rd=d.readiness||{}; var rv=(typeof rd.value==='number')?rd.value:null;
  var rEl=$('readiness');
  if(rEl){ if(rv===null){rEl.textContent='\u2014';} else {var prev=parseInt(rEl.textContent); tween(rEl,isNaN(prev)?rv:prev,Math.round(rv),650);} }
  if(rv!=null){ if(window.__lastRV!=null && Math.abs(rv-window.__lastRV)>=0.05) _pushProg(rv-window.__lastRV); window.__lastRV=rv; }
  var cov=(rd.coverage!=null)?rd.coverage:0;
  if($('conflabel')) $('conflabel').textContent = (rv==null)?'Not enough data yet':('Readiness '+Math.round(rv)+'%');
  if($('stablabel')) $('stablabel').textContent = cov+' concept'+(cov===1?'':'s')+' practised';
  if($('stabfill')) $('stabfill').style.width = (rv==null?0:Math.round(rv))+'%';
  var rchip=$('rdelta'); if(rchip) rchip.className='deltaChip';
  // Learning Health = per-concept mastery (backend-provided), highest first
  var box=$('dims');
  if(box){ box.innerHTML='';
    var ent=Object.keys(d.mastery||{}).map(function(k){return [k,d.mastery[k]];})
              .sort(function(a,b){return (b[1].mastery||0)-(a[1].mastery||0);});
    if(!ent.length){ box.innerHTML='<div class="muted" style="padding:6px 0">No concept data yet \u2014 answer a question below to start building your Learning Health.</div>'; }
    else ent.slice(0,8).forEach(function(kv){ var v=Math.round((kv[1].mastery||0)*100);
      var el=document.createElement('div'); el.className='dim';
      el.innerHTML='<div class="row"><span>'+kv[0]+'</span><span class="val">'+v+'%</span></div><div class="track"><div class="fill" style="width:'+v+'%"></div></div>';
      box.appendChild(el); }); }
  // Today's Focus = growth lever (backend-provided)
  var gl=d.growth_lever||{};
  if($('leverkey')) $('leverkey').textContent = gl.concept || 'Balanced \u2014 keep practising';
  if($('leverwhy')) $('leverwhy').textContent = gl.concept ? 'Your lowest-mastery concept right now \u2014 practising it lifts readiness the most.' : 'Answer a few questions and your focus area will appear here.';
  // Upcoming Reviews = revision schedule (backend-provided)
  var rbox=$('revision');
  if(rbox){ rbox.innerHTML='';
    var revs=d.revision||[];
    if(!revs.length){ rbox.innerHTML='<div class="muted" style="padding:6px 0">Nothing due yet \u2014 reviews appear as retention decays.</div>'; }
    else revs.slice(0,8).forEach(function(r){ var ret=Math.round((r.retention||0)*100);
      var cls=(r.due==='today')?'today':(r.due==='soon')?'soon':'safe';
      var lbl=(r.due==='today')?'Today':(r.due==='soon')?'Soon':'Later';
      var el=document.createElement('div'); el.className='revrow';
      el.innerHTML='<div><div style="font-weight:600;font-size:.92rem">'+r.concept+'</div><div class="muted">Retention '+ret+'%</div></div><span class="due '+cls+'">'+lbl+'</span>';
      rbox.appendChild(el); }); }
}
function _pushProg(delta){ var b=$('timeline'); if(!b)return;
  window.__prog=window.__prog||[];
  window.__prog.unshift({t:'Just now',g:Math.round(delta*10)/10}); if(window.__prog.length>6)window.__prog.pop();
  b.innerHTML=window.__prog.map(function(r){var up=r.g>0;return '<li><span class="td">'+r.t+'</span><span>Readiness '+(up?'improved':'dipped')+'</span><span class="tg '+(up?'up':'down')+'">'+(up?'+':'')+r.g+'</span></li>';}).join('');
}
function setMissionPlaceholder(){
  if($('actionline')) $('actionline').textContent='Practise to move your readiness';
  if($('actionreason')) $('actionreason').textContent='Answer questions below and watch your readiness and mastery update live. Guided daily missions arrive with AIVORA.';
  var mg=$('mgain'); if(mg) mg.style.display='none';
  var ms=$('missionsteps'); if(ms) ms.innerHTML='';
  if($('hdr-min')) $('hdr-min').textContent='Live';
  var sp=$('stagepill'); if(sp) sp.style.display='none';
  if($('whyline')) $('whyline').innerHTML='Your readiness is derived live from every question you answer \u2014 no guesswork, no demo data.';
}
/* ── M4: Mission Control renders the live mission from GET /me/mission (thin) ── */
async function renderMission(){
  try{
    const d = await api('/me/mission');
    const m = (d && d.active) || null;
    window.__mission = m;
    const btn = $('mh-mission-btn'); const tag = document.querySelector('.mh-tag');
    if(!m){
      if($('actionline')) $('actionline').textContent = 'No active mission';
      if($('actionreason')) $('actionreason').textContent = "Generate today's mission \u2014 AIVORA picks your highest-gain focus from your live learning state.";
      if($('missionsteps')) $('missionsteps').innerHTML='';
      if(tag) tag.textContent = "🧭 Today's Mission";
      if(btn){ btn.textContent='🚀 Generate today\u2019s mission'; btn.dataset.act='generate'; }
      return;
    }
    const target = (m.target_concept_ids||[])[0] || 'your focus area';
    if($('actionline')) $('actionline').textContent = 'Practise '+target;
    if($('actionreason')) $('actionreason').textContent = (m.state==='STARTED')
      ? 'Mission in progress \u2014 answer the questions below to complete it.'
      : 'Your highest-gain focus right now. Start when ready.';
    if($('missionsteps')){ $('missionsteps').innerHTML='';
      (m.steps||[]).forEach(function(st){ var li=document.createElement('li');
        li.innerHTML='<span class="sk">'+(st.kind||'practise')+'</span> '+(st.n||5)+' questions on '+(st.concept||target);
        $('missionsteps').appendChild(li); }); }
    if(tag) tag.textContent = "🧭 Today's Mission \u00B7 "+m.state;
    if(btn){ if(m.state==='CREATED'){ btn.textContent='\u25B6 Start Mission'; btn.dataset.act='start'; }
             else { btn.textContent='\u270F\uFE0F Continue practising'; btn.dataset.act='practise'; } }
  }catch(e){ console.warn('mission render failed:', e.message); }
}
window.missionAction = async function(){
  const btn=$('mh-mission-btn'); const act=btn?btn.dataset.act:'';
  try{
    if(act==='generate'){ await api('/me/mission/next',{method:'POST',body:'{}'}); await renderMission(); }
    else if(act==='start'){ var m=window.__mission; if(m&&m.mission_id){ await api('/me/mission/'+encodeURIComponent(m.mission_id)+'/start',{method:'POST',body:'{}'}); } await renderMission(); startMission(); }
    else { startMission(); }
  }catch(e){ console.warn('mission action failed:', e.message); startMission(); }
};
async function initLive(){
  if(!getToken())return false;
  try{
    setMissionPlaceholder();
    renderLearning(await api('/me/learning'));
    await renderMission();
    liveQ=await fetchLiveQuestions();
    if(liveQ.length) loadLiveQuestion();
    return true;
  }catch(e){console.warn('live init failed:',e.message);return false;}
}
/* boot: try live first; fall back to the offline demo engine */
(async function boot(){
  const live=await initLive();
  var sub=document.querySelector('.top .sub');
  if(live){ if(sub) sub.textContent='Live \u2014 every answer updates your readiness and mastery in real time.'; }
  else{ setMissionPlaceholder(); renderLearning({}); if(sub) sub.textContent='Sign in and answer a question to see your live learning state.'; }
})();
</script>

<script>
/* Presentation wrapper — augments render() for the redesigned Mission Control.
   Does NOT touch the verified engine; only feeds new header/timeline elements. */
(function(){
  try{if(location.search.indexOf('embed')>-1)document.documentElement.classList.add('embed');}catch(e){}
  var _orig=(typeof render==='function')?render:null;
  var _log=[];
  function renderTL(){var b=document.getElementById('timeline');if(!b)return;
    if(!_log.length){b.innerHTML='<li style="color:#9a8f77;border:none">Answer a question to start building your progress history.</li>';return;}
    b.innerHTML=_log.map(function(r){var up=r.g>0;return '<li><span class="td">'+r.t+'</span><span>Readiness '+(up?'improved':'dipped')+'</span><span class="tg '+(up?'up':'down')+'">'+(up?'+':'')+r.g+'</span></li>';}).join('');}
  function extras(p){try{
    var m=p&&p.mission;
    if(m){var eg=(p.decision&&p.decision.primary&&p.decision.primary.expected_impact);if(eg==null)eg=m.expected_impact;
      var mg=document.getElementById('mgain');if(mg){if(eg!=null){mg.style.display='inline-flex';mg.innerHTML='\u25B2 Expected readiness gain <b style="margin-left:6px">+'+eg+'</b>';}else{mg.style.display='none';}}
      var hm=document.getElementById('hdr-min');if(hm)hm.textContent='~'+(m.est_total_min!=null?m.est_total_min:'\u2014')+' min';}
    var rc=p&&p.state_delta&&p.state_delta.readiness&&p.state_delta.readiness.change;
    if(typeof rc==='number'&&rc!==0){_log.unshift({t:'Just now',g:rc});if(_log.length>6)_log.pop();renderTL();}
  }catch(e){}}
  if(_orig){render=function(p){_orig(p);extras(p);};}
  renderTL();
  window.startMission=function(){var c=document.getElementById('practicecard');if(c){c.style.display='';c.scrollIntoView({behavior:'smooth',block:'center'});}};
  window.mentorAsk=function(){var i=document.getElementById('mentorq');var t=(i&&i.value||'').trim();var c=document.getElementById('coachtxt');
    if(!t){if(c)c.textContent='Tell me what you would like help with \u2014 a concept, your schedule, or why today\u2019s mission was chosen.';return;}
    if(c)c.textContent='Good question. Open the full AI Mentor in the app for a complete answer \u2014 meanwhile, your best next move is the mission above.';if(i)i.value='';};
  window.uhLogout=function(e){if(e)e.preventDefault();try{['ias_token','ias_admin_token','token','access_token'].forEach(function(k){localStorage.removeItem(k);});}catch(_){}location.href='/learn';};
  document.addEventListener('click',function(){var u=document.getElementById('uhuser');if(u)u.classList.remove('open');});
  /* offline demo boots its first render before this wrapper installs; re-render once
     through the wrapped render so header (mission time), expected gain and timeline fill in.
     Guarded to offline only (no token) so live backend data is never overwritten. */
  /* M3: demo re-render removed — Mission Control renders only from GET /me/learning */
})();
</script>
</body>
</html>
