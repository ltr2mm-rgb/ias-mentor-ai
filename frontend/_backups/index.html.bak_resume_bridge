// ── API (with 120s timeout so slow AI calls don't fail) ───────────────────────
async function api(path, method='GET', body=null, auth=true) {
  const _mut=method&&String(method).toUpperCase()!=='GET';
  if(auth && !token && _mut){ openAuthModal('register'); throw new Error('__AUTH__'); }
  const h = {'Content-Type':'application/json'};
  if (auth && token) h['Authorization'] = 'Bearer ' + token;
  const controller = new AbortController();
  const to = setTimeout(() => controller.abort(), 300000);
  let r;
  try {
    r = await fetch(API + path, {method, headers:h, body:body?JSON.stringify(body):null, signal: controller.signal});
  } catch(err) {
    if(err && err.name==='AbortError') throw new Error('This is taking longer than usual — please try again in a moment.');
    throw new Error('Network problem — please check your connection and try again.');
  } finally {
    clearTimeout(to);
  }
  if(auth && r.status===401){ const _wl=!!token; token=''; localStorage.removeItem('ias_token'); if(_wl||_mut) openAuthModal('login'); throw new Error('__AUTH__'); }
  const _txt = await r.text();
  let d = null;
  try { d = _txt ? JSON.parse(_txt) : {}; } catch(e){ d = null; }
  if (!r.ok) {
    if([408,429,502,503,504,524].includes(r.status)) throw new Error('The server is busy right now — please wait a moment and try again.');
    throw new Error((d && d.detail) || ('Something went wrong (error '+r.status+'). Please try again.'));
  }
  if (d === null) throw new Error('The server sent an unexpected response — please try again.');
  return d;
}

async function _apiRetry(path, method, body, tries){
  let lastErr;
  for(let i=0;i<(tries||2);i++){
    try{ return await api(path, method, body); }
    catch(e){ lastErr=e; if(e.message==='__AUTH__') throw e; }
  }
  throw lastErr;
}
