function mdToHtml(md){
  const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  let out=''; let inList=false;
  (md||'').split('\n').forEach(raw=>{
    const line=raw.replace(/\s+$/,'');
    if(/^#{2,3}\s+/.test(line)){
      if(inList){out+='</ul>';inList=false;}
      out+=`<h3 style="margin:1.1rem 0 0.4rem;color:var(--accent);font-size:1.02rem">${esc(line.replace(/^#{2,3}\s+/,''))}</h3>`;
    }else if(/^\s*[-*]\s+/.test(line)){
      if(!inList){out+='<ul style="margin:0.3rem 0 0.3rem 1.1rem;padding:0">';inList=true;}
      out+=`<li style="margin:0.25rem 0">${esc(line.replace(/^\s*[-*]\s+/,'')).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')}</li>`;
    }else if(line.trim()===''){
      if(inList){out+='</ul>';inList=false;}
    }else{
      if(inList){out+='</ul>';inList=false;}
      out+=`<p style="margin:0.45rem 0">${esc(line).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')}</p>`;
    }
  });
  if(inList)out+='</ul>';
  return out;
}

