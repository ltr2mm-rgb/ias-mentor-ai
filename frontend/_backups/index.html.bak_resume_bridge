function _qesc(s){ return String(s).split("'").join(String.fromCharCode(92)+"'"); }
function _topicFrom(m){
  let t=(m||'').trim().toLowerCase();
  if(!t||t.length<4) return '';
  if(/(what should|motivate|feeling|on track|make me|my mistake|my progress|help me|start my|routine|^hi\b|^hello)/.test(t)) return '';
  t=t.replace(/^(what\s+is|what\s+are|what's|whats|explain|tell me about|define|describe|who\s+is|who\s+are|meaning of|teach me(\s+about)?|give me(\s+an?)?|tell me)\b[:\s]*/,'');
  t=t.replace(/[\s?.!:]+$/,'').trim();
  if(t.length<3||t.length>70||!/[a-z]/.test(t)) return '';
