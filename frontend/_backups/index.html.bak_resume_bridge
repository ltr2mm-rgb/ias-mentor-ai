async function loadMainsQuestions(){
  const out=document.getElementById('pyq-mains-output');
  out.innerHTML='<div class="empty"><div class="spinner"></div></div>';
  const year=document.getElementById('pyq-mains-year').value;
  const paper=document.getElementById('pyq-mains-paper').value;
  const subject=document.getElementById('pyq-mains-subject').value;
  if(!year||!paper){ out.innerHTML='<div class="empty">Select a <strong>year</strong> and a <strong>paper</strong> above to see the questions.</div>'; return; }
  const qs=[];
  if(year!=='__all__') qs.push('year='+encodeURIComponent(year));
  if(paper!=='__all__') qs.push('paper_code='+encodeURIComponent(paper));
  if(subject) qs.push('subject='+encodeURIComponent(subject));
  try{
    const d=await api('/pyq/mains/questions'+(qs.length?('?'+qs.join('&')):''));
    if(!d.questions.length){ out.innerHTML='<div class="empty">No questions match this filter.</div>'; return; }
    _mainsQ=d.questions;
    let html=`<div style="color:var(--muted);font-size:0.82rem;margin:0.3rem 0 0.8rem">📄 ${d.count} questions — read, then write your answer and get an instant AI evaluation.</div>`;
    let lastKey='';
    d.questions.forEach((q,i)=>{
      const key=q.year+' • '+q.paper;
      if(key!==lastKey){ html+=`<div style="font-weight:700;margin:1rem 0 0.5rem;color:var(--accent)">${key}</div>`; lastKey=key; }
      html+=`<div class="card" style="margin-bottom:0.5rem">
        <div style="font-size:0.95rem;line-height:1.6"><b>${i+1}.</b> ${esc(q.q)}</div>
        <div style="color:var(--muted);font-size:0.78rem;margin-top:0.5rem">
          <span class="badge badge-green">${esc(q.subject||'')}</span>
          ${q.marks?`<span style="margin-left:0.5rem">${q.marks} marks</span>`:''}${q.words?`<span style="margin-left:0.4rem">· ~${q.words} words</span>`:''}
        </div>
        <details style="margin-top:0.6rem"><summary style="cursor:pointer;color:var(--accent);font-weight:600;font-size:0.85rem">✍️ Write &amp; get AI evaluation</summary>
          <div style="margin-top:0.5rem">
            <textarea id="mains-ans-${i}" rows="6" placeholder="Write your answer here (intro → body → conclusion)…" style="resize:vertical"></textarea>
            <button class="btn btn-primary btn-sm" style="margin-top:0.5rem" onclick="evaluateMains(${i},this)">Evaluate my answer</button>
            <div id="mains-eval-${i}" style="margin-top:0.6rem"></div>
          </div>
        </details>
      </div>`;
    });
    out.innerHTML=html;
  }catch(e){ out.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`; }
}
let _mainsQ=[];
async function evaluateMains(i, btn){
  const q=_mainsQ[i]; if(!q) return;
  const ans=(document.getElementById('mains-ans-'+i).value||'').trim();
  const box=document.getElementById('mains-eval-'+i);
  if(ans.length<30){ box.innerHTML='<div class="alert alert-error">Write at least a few sentences first.</div>'; return; }
  const old=btn.innerHTML; btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Evaluating…';
  box.innerHTML='<div style="color:var(--muted);font-size:0.85rem">🤖 Your AI examiner is reading your answer…</div>';
  try{
    const d=await api('/me/mains/evaluate','POST',{question:q.q,answer:ans,marks:q.marks||10,paper:q.paper||''});
    const e=d.evaluation;
