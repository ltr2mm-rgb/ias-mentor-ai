  const _gcs=ncertGcsUrl(book.key);
  if(_gcs){ openPdfReader(_gcs, ncertBookLabel(book,i)); return; }
  // Legacy fallbacks (admin-uploaded copy, then official chapter PDF).
  const cnt=(_ncertUploaded && _ncertUploaded[book.key]) || 0;
