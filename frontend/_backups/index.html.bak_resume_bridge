<!-- MY PROFILE -->
<div id="panel-profile" class="panel">
  <div class="panel-title">👤 My Profile</div>
  <p style="color:var(--muted);font-size:0.9rem;margin:-0.5rem 0 1.25rem;line-height:1.6;">
    The more AIMENTORA knows about you, the better it can target practice, revision and your study plan.
    Nothing here is shared — it only personalises <strong>your</strong> preparation.
  </p>
  <div class="card" style="margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:0.8rem;">
      <div style="flex:1;">
        <div style="font-weight:600;">Profile completion</div>
        <div style="background:rgba(0,0,0,0.06);border-radius:99px;height:9px;margin-top:0.5rem;overflow:hidden;">
          <div id="profile-bar" style="height:100%;width:0%;background:var(--accent);transition:width .3s;"></div>
        </div>
      </div>
      <div id="profile-pct" style="font-weight:700;font-size:1.2rem;color:var(--accent);">0%</div>
    </div>
  </div>
  <!-- SECTION 1 · PERSONAL DETAILS -->
  <div class="card">
    <div style="font-weight:700;font-size:1.02rem;margin-bottom:0.7rem;color:var(--accent)">👤 Personal Details</div>
    <div class="two-col">
      <div class="form-group"><label>Candidate name</label>
        <input id="pf-full_name" placeholder="Full name as per records"></div>
      <div class="form-group"><label>Age</label>
        <input id="pf-age" type="number" min="0" max="120" placeholder="Your age in years"></div>
      <div class="form-group"><label>Gender</label>
        <select id="pf-gender"><option value="">Select…</option>
          <option>Male</option><option>Female</option><option>Other</option><option>Prefer not to say</option></select></div>
      <div class="form-group"><label>Home state / UT</label>
        <select id="pf-home_state" onchange="onProfileStateChange()"><option value="">Select…</option></select></div>
      <div class="form-group"><label>Phone number</label>
        <input id="pf-phone" type="tel" placeholder="10-digit mobile"></div>
      <div class="form-group"><label>Email ID</label>
        <input id="pf-email" type="email" placeholder="you@example.com"></div>
      <div class="form-group"><label>Graduation</label>
        <select id="pf-education"><option value="">Select…</option>
          <option>Undergraduate (pursuing)</option>
          <option>Graduate</option>
          <option>Postgraduate</option>
          <option>Professional (Engg/Med/Law etc.)</option></select></div>
      <div class="form-group"><label>Graduation discipline / stream</label>
        <select id="pf-graduation_stream"><option value="">Select…</option>
          <option>Arts / Humanities</option><option>Science</option><option>Commerce</option>
          <option>Engineering / Technology</option><option>Medical</option><option>Law</option>
          <option>Management</option><option>Other</option></select></div>
      <div class="form-group"><label>Medium of schooling</label>
        <select id="pf-schooling_medium"><option value="">Select…</option>
          <option>English medium</option><option>Regional / other medium</option>
          <option>Bilingual</option></select></div>
      <div class="form-group"><label>Graduation percentage / class</label>
        <select id="pf-degree_percentage"><option value="">Select…</option>
          <option>Below 50%</option><option>50–60%</option><option>60–70%</option>
          <option>70–80%</option><option>Above 80%</option></select></div>
      <div class="form-group"><label>Category</label>
        <select id="pf-category"><option value="">Select…</option></select></div>
      <div class="form-group"><label>Additional qualification (optional)</label>
        <input id="pf-additional_qualification" placeholder="e.g. PG in Economics, NET/JRF…"></div>
      <div class="form-group" style="grid-column:1/-1"><label>Are you working?</label>
        <select id="pf-working_professional" onchange="onWorkingChange()">
          <option value="false">No</option>
          <option value="true">Yes</option></select></div>
      <div class="form-group" id="pf-prep_intensity-wrap" style="display:none"><label>Full-time or part-time?</label>
        <select id="pf-prep_intensity"><option value="">Select…</option>
          <option>Full-time</option><option>Part-time</option></select></div>
      <div class="form-group" id="pf-work_experience-wrap" style="display:none;grid-column:1/-1"><label>Your working experience details</label>
        <textarea id="pf-work_experience" rows="2" placeholder="Role, organisation, years of experience, nature of work…"></textarea></div>
    </div>
  </div>

  <!-- SECTION 2 · EXAM PREFERENCE -->
  <div class="card" style="margin-top:1rem">
    <div style="font-weight:700;font-size:1.02rem;margin-bottom:0.7rem;color:var(--accent)">🎯 Exam Preference</div>
    <div class="two-col">
      <div class="form-group"><label>Target Prelims year</label>
        <select id="pf-target_year"><option value="">Select…</option>
          <option>2026</option><option>2027</option><option>2028</option><option>Not decided</option></select></div>
      <div class="form-group"><label>Optional subject (for Mains)</label>
        <select id="pf-optional_subject"><option value="">Select…</option></select></div>
      <div class="form-group"><label>Preferred study medium</label>
        <select id="pf-medium"><option value="">Select…</option>
          <option>English</option><option>Hindi</option><option>Bilingual</option></select></div>
      <div class="form-group"><label>Number of previous attempts</label>
        <select id="pf-attempts"><option value="">Select…</option>
          <option value="0">0 (first attempt)</option><option value="1">1</option>
          <option value="2">2</option><option value="3+">3 or more</option></select></div>
      <div class="form-group"><label>Where did you fall short?</label>
        <select id="pf-failure_stage" onchange="onFallShortChange()"><option value="">Select…</option>
          <option>Haven't attempted yet</option><option>Prelims</option>
          <option>Mains</option><option>Both Prelims and Mains</option>
          <option>Interview</option><option>Don't Know Exactly</option></select></div>
      <div class="form-group" id="fall-short-wrap" style="display:none;grid-column:1/-1">
        <label id="fall-short-label">Which paper(s)?</label>
        <div id="fall-short-opts" style="display:flex;flex-wrap:wrap;gap:.5rem 1.1rem;padding:.35rem .1rem"></div>
        <input type="hidden" id="pf-failure_reason">
      </div>
      <div class="form-group"><label>Preparation level so far</label>
        <select id="pf-prep_level"><option value="">Select…</option>
          <option>Just starting out</option><option>Built some basics</option>
          <option>Completed one full cycle</option><option>Revising / advanced</option></select></div>
      <div class="form-group"><label>Current knowledge level (self-rated)</label>
        <select id="pf-knowledge_level"><option value="">Select…</option>
          <option>Low</option><option>Moderate</option><option>Good</option><option>Strong</option></select></div>
      <div class="form-group"><label>Comprehension / reasoning (CSAT) skill</label>
        <select id="pf-comprehension_skill"><option value="">Select…</option>
          <option>Needs improvement</option><option>Average</option><option>Strong</option></select></div>
      <div class="form-group"><label>How you read</label>
        <select id="pf-reading_speed"><option value="">Select…</option>
          <option>Slow &amp; deep</option><option>Average pace</option><option>Fast skimmer</option></select></div>
      <div class="form-group"><label>Preferred learning style</label>
        <select id="pf-learning_style"><option value="">Select…</option>
          <option value="reading">Reading / notes</option>
          <option value="visual">Visual / maps &amp; diagrams</option>
          <option value="practice">Practice / MCQ-first</option>
          <option value="mixed">A mix of everything</option></select></div>
      <div class="form-group"><label>Daily study hours</label>
        <select id="pf-study_hours"><option value="" selected>Select…</option>
          <option value="0-2">0–2 hours</option><option value="2-4">2–4 hours</option>
          <option value="4-6">4–6 hours</option><option value="6-8">6–8 hours</option>
          <option value="8-10">8–10 hours</option><option value="10-12">10–12 hours</option>
          <option value="12+">12+ hours</option></select></div>
      <div class="form-group"><label>When you usually study</label>
        <select id="pf-study_time_windows"><option value="">Select…</option>
          <option>Early morning</option><option>Daytime</option><option>Evening</option>
          <option>Late night</option><option>Whenever I can</option></select></div>
      <div class="form-group"><label>Where you usually study</label>
        <select id="pf-study_place"><option value="">Select…</option>
