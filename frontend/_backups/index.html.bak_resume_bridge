let _ncertReader=null;   // {bookKey, pagesTotal, lastPage, completed}
function keyFromGcsUrl(url){
  let m=String(url||'').match(/aivora-production-ncert-books\/([a-z0-9_]+)\.pdf/i); if(m) return m[1];
  m=String(url||'').match(/\/ncert\/gcs\/([a-z0-9_]+)/i); if(m) return m[1];
  return '';
}
function _saveNcertProgress(extra){
  if(!token || !_ncertReader || !_ncertReader.bookKey) return;
  try{ api('/ncert/progress','POST',Object.assign({book_key:_ncertReader.bookKey}, extra||{})).catch(()=>{}); }catch(e){}
}
function _markNcertComplete(auto){
  if(!_ncertReader || _ncertReader.completed) return;
  _ncertReader.completed=true;
  _saveNcertProgress({status:'completed', last_page:_ncertReader.lastPage||0, pages_total:_ncertReader.pagesTotal||0});
  const mark=document.getElementById('pdf-mark-done');
  if(mark){ mark.innerHTML='✓ Completed'; mark.disabled=true; }
  if(typeof _readerToast==='function') _readerToast(auto?'Book completed — well done! 🎉':'Marked as completed 🎉');
  try{ if(typeof renderNcertDash==='function') renderNcertDash(); }catch(e){}
}
function markNcertBookDone(){ _markNcertComplete(false); }
function _ncertOnSeen(pnum){
  if(!_ncertReader) return;
  if(!_ncertReader.seen) _ncertReader.seen=new Set();
  _ncertReader.seen.add(pnum);
  if(pnum>_ncertReader.lastPage) _ncertReader.lastPage=pnum;
  const tot=_ncertReader.pagesTotal||0;
  // Auto-complete only once ~90% of DISTINCT pages have genuinely been viewed.
  if(tot>0 && _ncertReader.seen.size >= Math.ceil(tot*0.9)) _markNcertComplete(true);
}
// Open one of our hosted full-book PDFs in the canvas reader (with highlights/notes + progress).
