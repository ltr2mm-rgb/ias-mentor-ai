  beginAssessment: function(){
    BootstrapController._assessmentActive = true;                                /* Slice 5: mark this diagnostic run as bootstrap-owned */
    var o=document.getElementById('onboarding'); if(o) o.style.display='none';   /* leave the Bootstrap overlay */
    try{ openDiagnostic(); }catch(e){}                                           /* reuse existing diagnostic subsystem UNCHANGED */
  },
  /* ── Slice 5 (Analysis) + Slice 6 (Mission start) ─────────────────────────
     These two slices are ONE closing conversation: the analysis and the first
     mission are two halves of the same sentence. On completion the bootstrap flow
     shows a CONCLUSION (not a score report), then continues straight into the first
     mission — the learner never mentally leaves the mentor conversation and never
     re-sees raw scores. Slice 6 is a CONVERSATION HANDOFF, not a Mission Control
     redesign: it reuses startFirstStep() and owns only how the learner ARRIVES. */
  _assessmentActive: false,
  _lastObservation: null,
  _onAssessmentComplete: function(result){
    BootstrapController._assessmentActive = false;
    try{ loadToday(true); }catch(e){}        /* re-plan the mission at the new baseline (same side effect as legacy) */
    try{ loadDiagResult(); }catch(e){}       /* keep the profile-page result view in sync too */
    BootstrapController._renderAnalysis(result||{});
  },
  _PROMISE: 'This is only my first understanding of you. Every practice session will help me understand you better, and your study plan will become more personal over time.',
  /* Slice 5 surfaces the SINGLE coaching observation that matters most right now.
     Do NOT accumulate observations — find the dominant one. Each observer proposes an
     insight with a salience; the most salient wins. New signals (mastery velocity,
     confidence calibration, revision decay, weak concepts, careless errors, time
     pressure, consistency) join later as further observers on the SAME axis, and the
     UI never learns where the winning insight came from. Each observation carries lead (what I noticed) and consequence (what it means);
     the DIAGNOSTIC's authority ends at Slice 5. Slice 6 speaks with the MISSION ENGINE's
     authority instead — it renders the engine's own `why` for the chosen first task, so no
     diagnostic-derived copy ever crosses the boundary (the conversation introduces; the engine explains). */
  _dominantObservation: function(signals){
    var g=signals.gs, c=signals.csat, cand=[];
    if(typeof g!=='number' || typeof c!=='number'){
      return {lead:'I&#39;ve set your starting point.',
              second:'I&#39;ll understand you more precisely as you begin practising.',
              consequence:'So we&#39;ll start with a focused first mission and sharpen your plan from there.'};
    }
    var STRONG_G=75, STRONG_C=70, LOW=45, LEVEL=20, FLOOR=15, gap=g-c;
    cand.push({salience:gap,
      lead:(g>=STRONG_G?'You have a strong knowledge base.':'Your recall is ahead of your reasoning right now.'),
      second:'You&#39;re losing marks when questions ask you to reason and apply, rather than simply recall.',
      consequence:'So rather than giving you more facts, I&#39;ll first help you turn the knowledge you already have into marks.'});
    cand.push({salience:-gap,
      lead:(c>=STRONG_C?'You read and reason well under pressure.':'Your reasoning is ahead of your recall right now.'),
      second:'What&#39;s holding your score back is coverage &#8212; there&#39;s ground you haven&#39;t studied yet, not a thinking problem.',
      consequence:'So we&#39;ll build your knowledge base subject by subject, and lean on the reasoning strength you already have.'});
    if(g>=STRONG_G && c>=STRONG_C) cand.push({salience:LEVEL,
      lead:'You&#39;re starting from a strong base &#8212; in both knowledge and reasoning.',
      second:'You&#39;re further along than most learners at this stage.',
      consequence:'So we&#39;ll move quickly into harder ground, and focus on precision and timing rather than fundamentals.'});
    if(g<LOW && c<LOW) cand.push({salience:LEVEL,
      lead:'You&#39;re early in your preparation &#8212; both your knowledge and your reasoning are still building.',
      second:'That&#39;s a completely normal place to start, and the easiest place to make fast, visible progress.',
      consequence:'So we&#39;ll start with the fundamentals and build steadily, one concept at a time.'});
    cand.push({salience:FLOOR,
      lead:'Your knowledge and reasoning are at a similar, developing level.',
      second:'Nothing is badly behind &#8212; your fastest gains will come from steady, focused practice.',
      consequence:'So we&#39;ll strengthen both together, starting with the topics that appear most often in the exam.'});
    var best=cand[0];
    for(var i=1;i<cand.length;i++){ if(cand[i].salience>best.salience) best=cand[i]; }
    return best;
  },
  _analysisCopy: function(gs, csat){
    var o=BootstrapController._dominantObservation({gs:gs, csat:csat});
    BootstrapController._lastObservation = o;   /* Slice 6 continues this same observation's sentence */
    return {lead:o.lead, second:o.second, consequence:o.consequence, promise:BootstrapController._PROMISE};
  },
  _renderAnalysis: function(result){
    var body=document.getElementById('diag-body'); if(!body) return;             /* render IN the diagnostic overlay: no modal swap */
    var copy=BootstrapController._analysisCopy(result&&result.gs, result&&result.csat);
    body.innerHTML =
      '<div style="text-align:left">'
      + '<div style="font-family:\'Playfair Display\',serif;font-size:1.4rem;line-height:1.3;margin-bottom:1.1rem">Here&#39;s what I noticed about your preparation.</div>'
      + '<div style="font-weight:800;font-size:1.05rem;line-height:1.45;margin-bottom:0.4rem">'+copy.lead+'</div>'
      + '<div style="color:var(--text);font-size:0.95rem;line-height:1.6;margin-bottom:1.25rem">'+copy.second+'</div>'
      + '<div style="color:var(--text);font-size:0.95rem;line-height:1.6;margin-bottom:1.3rem">'+copy.consequence+'</div>'
      + '<div style="border-top:1px solid var(--border);padding-top:0.9rem;color:var(--muted);font-size:0.85rem;line-height:1.6;margin-bottom:1.3rem">'+copy.promise+'</div>'
      + '<button class="btn btn-primary" style="width:100%" onclick="BootstrapController.enterFromAnalysis()">Begin my first mission &#8594;</button>'
      + '</div>';
    var ov=document.getElementById('diag-overlay'); if(ov) ov.classList.add('open');
  },
  /* Slice 6: continue the sentence into the first step — NEVER a self-introduction,
     NEVER a re-shown score, NO product nouns (Mission/Program/Task/Module). Answers
     one learner question: "So where do we begin?" */
  enterFromAnalysis: function(){
    var ready=false; try{ ready=!!(_today && _today.mission); }catch(e){ ready=false; }
    if(ready){ BootstrapController._renderMissionStart(); return; }
    var body=document.getElementById('diag-body'); if(body) body.innerHTML='<div class="empty"><div class="spinner"></div></div>';
    try{ Promise.resolve(loadToday(true)).then(function(){ BootstrapController._renderMissionStart(); }).catch(function(){ BootstrapController._renderMissionStart(); }); }
    catch(e){ BootstrapController._renderMissionStart(); }
  },
  _renderMissionStart: function(){
    var body=document.getElementById('diag-body'); if(!body) return;
    /* Everything after the bridge line is ENGINE-OWNED: render the Mission Engine's own reason
       for the chosen first step (why -> detail -> impact), never the diagnostic focus. */
    var why='', mins=null;
    try{ if(_today && _today.mission){ var tks=_today.mission.tasks||[], ft=null;
      for(var j=0;j<tks.length;j++){ if(!tks[j].done){ ft=tks[j]; break; } } if(!ft && tks.length) ft=tks[0];
      if(ft){ why=ft.why || ft.detail || ft.impact || ''; if(typeof ft.minutes==='number') mins=ft.minutes; } } }catch(e){}
    if(!why) why='This is the best next step for where you are right now.';   /* engine gave nothing — neutral, never the diagnostic focus */
    var estLine = mins ? ('<div style="color:var(--muted);font-size:0.9rem;margin-top:0.6rem">&#9201;&#65039; ~ '+mins+' min</div>') : '';
    body.innerHTML =
      '<div style="text-align:left">'
      + '<div style="font-family:\'Playfair Display\',serif;font-size:1.35rem;line-height:1.3;margin-bottom:0.9rem">So, here&#39;s where we&#39;ll begin.</div>'   /* the ONLY conversation-owned line */
      + '<div style="color:var(--text);font-size:1.02rem;font-weight:600;line-height:1.55">'+esc(why)+'</div>'
      + estLine
      + '<button class="btn btn-primary" style="width:100%;margin-top:1.6rem" onclick="BootstrapController.startFirstMission(this)">Let&#39;s start &#8594;</button>'
      + '</div>';
    var ov=document.getElementById('diag-overlay'); if(ov) ov.classList.add('open');
  },
  startFirstMission: function(btn){
    var body=document.getElementById('diag-body');
    if(body) body.innerHTML='<div class="empty"><div class="spinner"></div><div style="color:var(--muted);margin-top:0.6rem;font-size:0.9rem">Setting up your first step&#8230;</div></div>';
    try{ startFirstStep(btn); }catch(e){}     /* reuse the EXISTING first-step launcher — drops the learner into the real task */
    try{ closeDiagnostic(); }catch(e){}
  }
};

