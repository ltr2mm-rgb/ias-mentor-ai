      <div class="form-group"><label>Strong subjects (comma-separated)</label>
        <input id="pf-strong_subjects" placeholder="e.g. Polity, Modern History"></div>
      <div class="form-group"><label>Weak subjects (comma-separated)</label>
        <input id="pf-weak_subjects" placeholder="e.g. Economy, Environment, Science &amp; Tech"></div>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:1rem;margin-top:1.25rem;">
