/* Mobile drawer = the SAME canonical navigation tree as the desktop top bar (DESKTOP_NAV:
   Learn through MCQs / Self Preparation Hub / Track & Improve + Home, AI Marga, Study & Notes),
   rendered as ACCORDIONS instead of dropdowns, with dedupe:true.
   dedupe: desktop cross-lists a few destinations across groups (NCERT · Study Material · My Notes);
   the mobile index shows each destination ONCE — a destination with NAV[id].canonicalGroup renders in that
   canonical home group, otherwise first occurrence wins. Hierarchy, groups, and order
   stay identical to desktop; only repeated destinations are suppressed. This is a PRESENTATION rule,
   not a separate IA — new / renamed / reordered / re-icon'd destinations in DESKTOP_NAV & NAV flow to
   mobile automatically; the only reason to edit here again is a change to the mobile *presentation*. */
function mnavToggle(btn){ btn.parentNode.classList.toggle('open'); }
function mnavBtn(id){
  return '<button class="sidebar-item" onclick="showPanel(\''+NAV[id].route+'\');closeSidebarMobile()">'
       + '<span class="sidebar-icon">'+NAV[id].icon+'</span>'+dnavEsc(NAV[id].label)+'</button>';
}
function mnavAcc(title, body, open){
  if(!body) return '';   // a group fully absorbed by an earlier group (all its items deduped) renders nothing
  return '<div class="mnav-acc'+(open?' open':'')+'"><button class="mnav-acc-head" onclick="mnavToggle(this)">'
       + dnavEsc(title)+' <span class="mnav-caret">\u25BE</span></button><div class="mnav-acc-body">'+body+'</div></div>';
}
var MNAV_HOME='<button class="sidebar-item" onclick="showPanel(\'home\');closeSidebarMobile()"><span class="sidebar-icon">\u{1F3E0}</span>Home</button>';
var MNAV_MARGA='<button class="sidebar-item tnav-marga" onclick="openMarga();closeSidebarMobile()"><span class="sidebar-icon">\u2605</span><span class="aimw"><span class="a">AI</span> <span class="m">Marga</span></span></button>';
/* the mobile tree = DESKTOP_NAV's groups + Study & Notes (a desktop group too), as id lists */
var MNAV_TREE = DESKTOP_NAV.map(function(g){return {key:g.workspace, title:g.title, items:g.items.map(function(it){return (typeof it==='string')?it:it.id;})};})
                 .concat([{key:'study_notes', title:'Study & Notes', items:['study_material','notes','interview']}]);
function renderMobileNavInner(){
  var claimed={home:1, ai_marga:1};              // dedupe:true — each destination rendered once
  var out=MNAV_HOME+MNAV_MARGA, opened=false;
  MNAV_TREE.forEach(function(sec){
    var body=sec.items.filter(function(id){
      if(claimed[id]) return false;              // already placed in an earlier group
      var hg=NAV[id] && NAV[id].canonicalGroup;       // canonical home (NAV.canonicalGroup) wins over first-occurrence
      if(hg && hg!==sec.key) return false;       // pinned to another group -> suppress here (leave unclaimed)
      claimed[id]=1; return true;
    }).map(mnavBtn).join('');
    var isOpen=!opened && !!body;                 // open the first non-empty section by default
    if(body) opened=true;
    out+=mnavAcc(sec.title, body, isOpen);
  });
  return out;
}
