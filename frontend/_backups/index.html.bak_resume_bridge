function computeAge(){
  const dobEl=document.getElementById('pf-dob');
  const ageEl=document.getElementById('pf-age');
  if(!dobEl||!ageEl) return;
  const v=dobEl.value;
  if(!v){ ageEl.value=''; return; }
  const b=new Date(v);
  if(isNaN(b.getTime())){ ageEl.value=''; return; }
  const now=new Date();
  let a=now.getFullYear()-b.getFullYear();
  const m=now.getMonth()-b.getMonth();
  if(m<0||(m===0&&now.getDate()<b.getDate())) a--;
  ageEl.value=(a>=0&&a<130)?a:'';
}

