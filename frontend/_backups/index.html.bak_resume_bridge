function mdLite(t){
  let h=esc(t||'');
  h=h.replace(/^\s*#{1,6}\s+(.*)$/gm,'<div style="font-weight:700;margin:0.6rem 0 0.2rem">$1</div>');
  h=h.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>');
  h=h.replace(/^\s*[-•]\s+(.*)$/gm,'• $1');
  return h.replace(/\n/g,'<br>');
}
