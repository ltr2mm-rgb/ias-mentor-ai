async function loadTests(){
  const el=document.getElementById('tests-list');
  el.innerHTML='<div class="empty"><div class="spinner"></div></div>';
  try{
    const d=await api('/mock-tests/');
    if(!d.mock_tests.length){
      el.innerHTML='<div class="empty"><div class="empty-icon">📋</div><p>No tests yet.<br>Create your first mock test!</p></div>'; return;
    }
    el.innerHTML=d.mock_tests.map(t=>{
      const hasQ = t.questions_added>0;
      return `<div class="test-card">
        <div class="test-info">
          <div class="title">${t.title}</div>
          <div class="meta">
            <span class="badge badge-blue">${t.subject}</span>
            <span>📝 ${t.questions_added}/${t.total_questions} questions</span>
            <span>⏱ ${t.duration_minutes} min</span>
            <span>👥 ${t.attempts_count} attempts</span>
          </div>
        </div>
        <div class="test-actions">
          ${!hasQ?`<button class="btn btn-secondary btn-sm" onclick="populateTest(${t.id},'${t.title}')">✨ Add AI Questions</button>`:''}
          <button class="btn btn-primary btn-sm" onclick="startTest(${t.id},'${t.title}',${t.duration_minutes})" ${!hasQ?'disabled':''}>
            ${hasQ?'Start Test':'No Questions'}
          </button>
        </div>
      </div>`;
    }).join('');
  }catch(e){el.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`;}
}

function openCreateTest(){document.getElementById('modal-create').classList.add('open');document.getElementById('modal-alert').innerHTML='';}
function closeModal(){document.getElementById('modal-create').classList.remove('open');}

async function doCreateTest(){
  const title=document.getElementById('ct-title').value.trim();
  const topic=document.getElementById('ct-topic').value.trim();
  const autoGen=document.getElementById('ct-autogen').checked;
  if(!title) return document.getElementById('modal-alert').innerHTML='<div class="alert alert-error">Please enter a title</div>';
  if(autoGen && !topic) return document.getElementById('modal-alert').innerHTML='<div class="alert alert-error">Please enter a topic for AI generation</div>';
  const btn=document.getElementById('btn-create');
  btn.disabled=true; btn.innerHTML=autoGen?'<span class="spinner"></span> Generating...':'<span class="spinner"></span> Creating...';
  try{
    const d=await api('/mock-tests/','POST',{
      title, subject:document.getElementById('ct-subject').value,
      topic:topic||null, description:document.getElementById('ct-desc').value,
      total_questions:parseInt(document.getElementById('ct-q').value),
      duration_minutes:parseInt(document.getElementById('ct-dur').value),
      auto_generate:autoGen,
    });
    closeModal();
    if(autoGen && d.questions_added>0){
      alert(`✅ Test created with ${d.questions_added} AI-generated questions!`);
    } else if(autoGen && d.questions_added===0){
      alert('Test created, but AI question generation failed. You can add questions manually.');
    }
    showPanel('tests');
  }catch(e){document.getElementById('modal-alert').innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`;}
  btn.disabled=false; btn.innerHTML='Create Test';
}

async function populateTest(id, title){
  const topic = prompt(`Enter topic for AI to generate questions for:\n"${title}"`);
  if(!topic) return;
  try{
    const d=await api(`/mock-tests/${id}/ai-populate/?topic=${encodeURIComponent(topic)}`,'POST');
    alert(`✅ Added ${d.questions_added} AI questions to the test!`);
    loadTests();
  }catch(e){alert('Error: '+e.message);}
}

// ── TAKE TEST ─────────────────────────────────────────────────────────────────
async function downloadTestPDF(id, title, withAnswers){
  if(withAnswers===undefined) withAnswers=true;
  try{
    const d=await api(`/mock-tests/${id}/questions/`);
    const qs=d.questions||[];
    if(!qs.length) return alert('No questions to export.');
    const e2=s=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const rows=qs.map((q,i)=>{
      const opts=[['A',q.option_a],['B',q.option_b],['C',q.option_c],['D',q.option_d]]
        .filter(o=>o[1]!=null&&o[1]!=='')
        .map(o=>`<div class="opt${(withAnswers&&(q.correct_answer||'').toUpperCase()===o[0])?' correct':''}">(${o[0]}) ${e2(o[1])}</div>`).join('');
      return `<div class="q"><div class="qt">${i+1}. ${e2(q.text)}</div>${opts}`+
        (withAnswers?`<div class="ans"><b>Answer:</b> ${e2((q.correct_answer||'').toUpperCase())}</div>`:'')+
        (withAnswers&&q.explanation?`<div class="exp"><b>Explanation:</b> ${e2(q.explanation)}</div>`:'')+`</div>`;
    }).join('');
    const html=`<!doctype html><html><head><meta charset="utf-8"><title>${e2(title||'AIMENTORA MCQs')}</title>`+
      `<style>body{font-family:Georgia,serif;max-width:800px;margin:24px auto;padding:0 16px;color:#111}`+
      `h1{font-size:20px;border-bottom:2px solid #333;padding-bottom:8px}.brand{color:#888;font-size:12px;margin-bottom:16px}`+
      `.q{margin:0 0 16px;page-break-inside:avoid}.qt{font-weight:bold;margin-bottom:6px}`+
      `.opt{margin:2px 0 2px 14px}.opt.correct{font-weight:bold;color:#0a7d34}`+
      `.ans{margin:6px 0 0 14px;font-size:14px}.exp{margin:4px 0 0 14px;font-size:13px;color:#444}`+
      `@media print{.noprint{display:none}}</style></head><body>`+
      `<h1>${e2(title||'AIMENTORA — Practice MCQs')}${withAnswers?' (with Answers)':' (Questions)'}</h1>`+
      `<div class="brand">Generated by AIMENTORA · aimentora.in · ${qs.length} questions${withAnswers?' · with answer key':' · questions only'}</div>`+
      `<button class="noprint" onclick="window.print()" style="margin-bottom:16px;padding:8px 16px;cursor:pointer">🖨 Save as PDF</button>`+
      rows+`<script>setTimeout(function(){window.print()},500)<\/script></body></html>`;
    const w=window.open('','_blank');
    if(!w) return alert('Please allow pop-ups so the PDF can open in a new tab.');
    w.document.write(html); w.document.close();
  }catch(e){ alert('Could not build PDF: '+e.message); }
}
async function startTest(id, title, duration){
  // Visitors can browse papers, but attempting one requires a free account.
  if(!token){ openAuthModal('register'); return; }
  showPanel('take-test');
  const el=document.getElementById('test-ui');
  el.innerHTML='<div class="empty"><div class="spinner"></div><p style="margin-top:1rem;color:var(--muted)">Loading questions...</p></div>';
  try{
    const d=await api(`/mock-tests/${id}/questions/`);
    if(!d.questions.length){
      el.innerHTML='<div class="alert alert-error">No questions in this test.</div><button class="btn btn-secondary" onclick="showPanel(\'tests\')" style="margin-top:1rem">← Back</button>'; return;
    }
    currentTest={id,title,duration,questions:d.questions};
    testAnswers={}; testConfidence={}; testPickTs={}; quizStartTs=Date.now();
    timeLeft=duration*60;
    renderTest();
    startTimer();
  }catch(e){el.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`;}
}

function renderTest(){
  const {title,questions}=currentTest;
  document.getElementById('test-ui').innerHTML=`
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
      <div style="font-weight:600;font-size:1.05rem;">${title}</div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
        <button class="btn btn-secondary btn-sm" onclick="downloadTestPDF(${currentTest.id},'${(title||'').replace(/'/g,"\\'")}',false)">📄 Download questions</button>
        <button class="btn btn-secondary btn-sm" onclick="if(confirm('Exit test?')){clearInterval(timerInt);showPanel('home');}">✕ Exit</button>
      </div>
    </div>
    <div class="timer-bar">
      <span style="font-size:0.82rem;color:var(--muted)">Time Left</span>
      <div class="prog-wrap"><div class="prog-bar" id="prog" style="width:100%"></div></div>
      <span class="timer-val" id="timer">--:--</span>
    </div>
    ${questions.map((q,i)=>`
      <div class="q-card">
        <div class="q-text"><strong>Q${i+1}.</strong> ${q.text.replace(/\n/g,'<br>')}</div>
        <div class="options">
          ${['A','B','C','D'].map(l=>`
            <div class="opt" id="opt-${q.id}-${l}" onclick="pick(${q.id},'${l}')">
              <div class="opt-letter">${l}</div><div>${q['option_'+l.toLowerCase()]}</div>
            </div>`).join('')}
        </div>
        <div class="conf-row" id="conf-${q.id}" style="display:none;align-items:center;gap:0.5rem;flex-wrap:wrap;margin-top:0.85rem;padding-top:0.7rem;border-top:1px dashed rgba(0,0,0,0.08);">
          <span style="font-size:0.8rem;color:var(--muted)">How sure were you?</span>
          <button type="button" class="conf-btn" id="conf-${q.id}-sure" onclick="setConf(${q.id},'sure')">😎 Sure</button>
          <button type="button" class="conf-btn" id="conf-${q.id}-unsure" onclick="setConf(${q.id},'unsure')">🤔 Unsure</button>
          <button type="button" class="conf-btn" id="conf-${q.id}-guess" onclick="setConf(${q.id},'guess')">🎲 Guess</button>
        </div>
      </div>`).join('')}
    <div style="display:flex;align-items:center;gap:1rem;margin-top:1rem;">
      <button class="btn btn-primary" onclick="submitTest()">Submit Test</button>
      <span id="ans-count" style="color:var(--muted);font-size:0.85rem">0 of ${questions.length} answered</span>
    </div>`;
}

function pick(qId,letter){
  const first=!(qId in testAnswers);
  testAnswers[qId]=letter;
  if(first||!testPickTs[qId]) testPickTs[qId]=Date.now();
  ['A','B','C','D'].forEach(l=>document.getElementById(`opt-${qId}-${l}`).classList.toggle('selected',l===letter));
  document.getElementById('ans-count').textContent=`${Object.keys(testAnswers).length} of ${currentTest.questions.length} answered`;
  // Reveal the one-tap confidence prompt; advancing happens after they tap it.
  const conf=document.getElementById('conf-'+qId);
  if(conf) conf.style.display='flex';
}

function setConf(qId,level){
  testConfidence[qId]=level;
  ['sure','unsure','guess'].forEach(l=>{
    const b=document.getElementById(`conf-${qId}-${l}`);
    if(b) b.classList.toggle('active',l===level);
  });
  // Auto-advance: smoothly scroll to the next question (or the submit bar if last)
  const card=document.getElementById('conf-'+qId).closest('.q-card');
  if(card){
    let nxt=card.nextElementSibling;
    while(nxt && !nxt.classList.contains('q-card')) nxt=nxt.nextElementSibling;
    const target=nxt||document.getElementById('ans-count');
    setTimeout(()=>target.scrollIntoView({behavior:'smooth',block:nxt?'start':'center'}),200);
  }
}

function startTimer(){
  clearInterval(timerInt);
  const total=timeLeft;
  timerInt=setInterval(()=>{
    timeLeft--;
    const m=String(Math.floor(timeLeft/60)).padStart(2,'0'), s=String(timeLeft%60).padStart(2,'0');
    const td=document.getElementById('timer'), pb=document.getElementById('prog');
    if(td) td.textContent=`${m}:${s}`;
    if(pb) pb.style.width=(timeLeft/total*100)+'%';
    if(timeLeft<=60&&td) td.style.color='var(--danger)';
    if(timeLeft<=0){clearInterval(timerInt);submitTest();}
  },1000);
}

async function submitTest(){
  clearInterval(timerInt);
  // Estimate per-question time from the order answers were picked.
  const picked=Object.entries(testPickTs).map(([q,ts])=>[parseInt(q),ts]).sort((a,b)=>a[1]-b[1]);
  const timeFor={}; let prev=quizStartTs||(picked.length?picked[0][1]:0);
  picked.forEach(([q,ts])=>{ timeFor[q]=Math.max(0,Math.min(900,Math.round((ts-prev)/1000))); prev=ts; });
  const answers=Object.entries(testAnswers).map(([qId,opt])=>{
    const id=parseInt(qId);
    return {question_id:id,selected_option:opt,
            confidence:testConfidence[id]||null,
            time_taken:(id in timeFor)?timeFor[id]:null};
  });
  try{
    const r=await api(`/mock-tests/${currentTest.id}/submit/`,'POST',answers);
    showResults(r);
  }catch(e){alert(emsg(e));}
}

