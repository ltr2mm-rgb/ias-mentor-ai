    const flags=`<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.8rem;margin-bottom:1.25rem">
      ${flagCard('⚠️',f.overconfident||0,'Confidently wrong','Real knowledge gaps — you were sure but missed. Top priority to fix.','var(--danger)')}
      ${flagCard('🍀',f.lucky_guesses||0,'Lucky guesses','Right by luck. Do not mistake these for mastery — revise them anyway.','var(--accent)')}
      ${flagCard('💪',f.underselling||0,'Underselling yourself','Unsure but correct. You know more than you think — trust your reasoning.','var(--success)')}
      ${flagCard('⚡',f.careless||0,'Careless slips','Fast and wrong. Slow down and read every option fully.','var(--accent)')}
    </div>`;
    // Confidence calibration bars
    const calRows=(d.calibration||[]).filter(c=>c.attempted>0).map(c=>{
      const acc=c.accuracy||0, bc=acc>=60?'var(--success)':acc>=40?'var(--accent)':'var(--danger)';
      return `<div style="display:flex;align-items:center;gap:0.6rem;margin:0.4rem 0">
        <div style="width:120px;font-size:0.85rem">${CONF_LABEL[c.confidence]||c.confidence}</div>
        <div style="flex:1;background:var(--bg);border-radius:6px;height:10px;overflow:hidden"><div style="width:${acc}%;height:100%;background:${bc}"></div></div>
        <div style="width:120px;text-align:right;font-size:0.8rem;color:var(--muted)">${c.correct}/${c.attempted} · ${acc}%</div>
      </div>`;}).join('');
    // Guess quality
    const gq=d.guess_quality||{};
    let guessBlock='';
    if(gq.attempted){
      const beat=gq.accuracy>gq.baseline+5, near=Math.abs(gq.accuracy-gq.baseline)<=5;
      const verdict=beat?'<span style="color:var(--success)">Good elimination — your guesses beat random.</span>':(near?'<span style="color:var(--accent)">Roughly random — work on eliminating 1–2 options before guessing.</span>':'<span style="color:var(--danger)">Below random — these guesses are costing you marks; skip when you cannot eliminate.</span>');
      guessBlock=`<div class="card" style="margin-bottom:1rem">
        <div style="font-weight:600;margin-bottom:0.3rem">🎲 Guess quality (elimination skill)</div>
        <div style="font-size:0.85rem;color:var(--muted);margin-bottom:0.5rem">Accuracy on guessed questions: <strong style="color:var(--text)">${gq.accuracy}%</strong> vs ${gq.baseline}% random baseline. ${verdict}</div>
      </div>`;
    }
    // Reason breakdown
    const rb=d.reason_breakdown||[];
    const rmax=Math.max(1,...rb.map(r=>r.count));
    const RL={conceptual:'🧠 Conceptual gap',factual:'📌 Factual slip',careless:'⚡ Careless',misread:'👓 Misread',guess:'🎲 Guess',review:'🔍 Needs review'};
    const reasonBlock=rb.length?`<div class="card" style="margin-bottom:1rem">
      <div style="font-weight:600;margin-bottom:0.5rem">📕 What your mistakes are made of</div>
      ${rb.map(r=>`<div style="display:flex;align-items:center;gap:0.6rem;margin:0.35rem 0">
        <div style="width:150px;font-size:0.84rem">${RL[r.reason]||r.reason}</div>
        <div style="flex:1;background:var(--bg);border-radius:6px;height:10px;overflow:hidden"><div style="width:${Math.round(r.count/rmax*100)}%;height:100%;background:var(--danger)"></div></div>
        <div style="width:40px;text-align:right;font-size:0.8rem;color:var(--muted)">${r.count}</div>
      </div>`).join('')}</div>`:'';
    const timeBlock=d.avg_time_per_q!=null?`<div style="color:var(--muted);font-size:0.82rem;margin-top:0.5rem">⏱️ Avg ~${d.avg_time_per_q}s per question · ${d.fast_answers} answered in under 8s.</div>`:'';
    el.innerHTML=`${flags}
      <div class="card" style="margin-bottom:1rem">
        <div style="font-weight:600;margin-bottom:0.5rem">🎯 Confidence calibration</div>
        <div style="font-size:0.82rem;color:var(--muted);margin-bottom:0.6rem">How accurate you actually are at each confidence level. Ideally "Sure" sits high and "Guess" low.</div>
        ${calRows||'<div style="color:var(--muted);font-size:0.85rem">Tap your confidence after answers to build this.</div>'}
      </div>
      ${guessBlock}${reasonBlock}${timeBlock}`;
  }catch(e){ el.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`; }
}

