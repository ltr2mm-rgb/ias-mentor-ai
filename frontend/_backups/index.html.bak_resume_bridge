    if(t.kind==='read'){ try{await initNcert();}catch(e){} const _ru=resolveBookPdf(p.read_url,p.book_key); if(_ru) openPdfReader(_ru,t.title||'Reading'); else showPanel('ncert'); await _progMarkDone(id); return; }
    if(t.kind==='revise'){ showPanel('revision'); await _progMarkDone(id); return; }
    if(t.kind==='weak'){ showPanel('weak'); await _progMarkDone(id); return; }
    if(t.kind==='readiness'){ showPanel('readiness'); await _progMarkDone(id); return; }
    if(t.kind==='mock'){ showPanel('simulator'); await _progMarkDone(id); return; }
    if(t.kind==='pyq_year'){ showPanel('pyq'); await _progMarkDone(id); return; }
    btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Building…';
    let d;
    if(t.kind==='ncert_test') d=await api('/ncert/generate','POST',{book_key:p.book_key,chapter:'',num_questions:25,difficulty:'medium',question_type:'all'});
    else if(t.kind==='subject_test') d=await api('/mock-tests/generate-verified/','POST',{subject:p.subject,topic:'',num_questions:25,difficulty:'medium',question_type:'all',reuse:true});
    else if(t.kind==='pyq') d=await api('/mock-tests/previous-year/','POST',{subject:p.subject||'',year:'',num_questions:25});
    else if(t.kind==='csat') d=await api('/pyq/csat/start','POST',{area:p.area||'reasoning'});
    btn.disabled=false; btn.innerHTML=old;
    if(d && d.mock_test_id){
