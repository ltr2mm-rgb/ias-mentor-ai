function _hideSelToolbar(){ const tb=document.getElementById('sel-toolbar'); if(tb) tb.classList.remove('open'); }
async function saveClipFromSelection(){
  _hideSelToolbar();
  if(!_readerCtx) return;
  const sel=window.getSelection(); const text=sel?sel.toString().trim():'';
  if(!text) return;
  let ch=_readerCtx.chapterIndex;
  try{
    const range=sel.getRangeAt(0);
    let node=range.startContainer; node=(node.nodeType===1?node:node.parentElement);
    const pageEl=node&&node.closest?node.closest('.pdfpage'):null;
    if(pageEl) ch=+pageEl.dataset.ch;
  }catch(e){}
  try{
    const d=await api('/me/reader/note','POST',{book_key:_readerCtx.bookKey, chapter_index:ch, kind:'note', text:text});
    _readerNotes.push(d.note); sel.removeAllRanges(); renderReaderNotesPanel();
    _readerToast('💾 Saved to My Notes');
  }catch(e){ alert('Could not save: '+e.message); }
}
async function saveHighlightFromSelection(){
  _hideSelToolbar();
  if(!_readerCtx) return;
  const sel=window.getSelection(); const text=sel?sel.toString().trim():'';
  if(!text) return;
  const range=sel.getRangeAt(0);
  let node=range.startContainer; node=(node.nodeType===1?node:node.parentElement);
  const pageEl=node&&node.closest?node.closest('.pdfpage'):null;
  if(!pageEl){ return; }
  const pr=pageEl.getBoundingClientRect();
  const rects=[...range.getClientRects()].map(r=>({
    x:(r.left-pr.left)/pr.width, y:(r.top-pr.top)/pr.height,
    w:r.width/pr.width, h:r.height/pr.height
  })).filter(r=>r.w>0.001&&r.h>0.001&&r.y>=-0.02&&r.y<=1.02);
  if(!rects.length){ return; }
  const ch=+pageEl.dataset.ch, pg=+pageEl.dataset.pg;
  const label=_currentHlLabel(); const color=HL_LABEL_COLORS[label]||'#f5d032';
  try{
    const d=await api('/me/reader/note','POST',{book_key:_readerCtx.bookKey, chapter_index:ch, kind:'highlight', page:pg, text:text, rects:rects, color:color, label:label});
    _readerNotes.push(d.note);
    const lyr=pageEl.querySelector('.hl-layer'); if(lyr) lyr.innerHTML='';
    _drawSavedHighlights(pageEl, ch, pg);
    sel.removeAllRanges();
    renderReaderNotesPanel();
    _readerToast('🖍 '+label+' highlight saved');
  }catch(e){ alert('Could not save highlight: '+e.message); }
}
