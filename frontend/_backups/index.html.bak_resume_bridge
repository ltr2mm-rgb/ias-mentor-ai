async function generateInterview(){
  const btn=document.getElementById('daf-gen-btn');
  const body={};
  DAF_FIELDS.forEach(([k])=>{const v=document.getElementById('daf-'+k); if(v&&v.value.trim()) body[k]=v.value.trim();});
  const ex=document.getElementById('daf-extra'); if(ex&&ex.value.trim()) body.extra=ex.value.trim();
  if(Object.keys(body).length<2){ alert('Fill in at least two fields — home state and education are a good start.'); return; }
  btn.disabled=true; btn.innerHTML='<span class="spinner" style="width:14px;height:14px;border-width:2px"></span> Building your board\'s question bank…';
  try{
    const d=await api('/me/interview/generate','POST',body);
    renderInterviewBank(d.questions, d.daf, new Date().toISOString());
  }catch(e){
    btn.disabled=false; btn.textContent='🎤 Generate my question bank';
    alert('Generation failed: '+e.message+' — try again.');
