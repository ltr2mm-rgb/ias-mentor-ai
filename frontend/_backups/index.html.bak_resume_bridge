let shMode='notes';
let shLastCA='';
const SH_MODES=[['notes','📝 Notes'],['flashcards','🃏 Flashcards'],['mnemonics','🧠 Mnemonics'],['mindmap','🗺️ Mind Map'],['ca','🗞️ Current Affairs']];
function shPlaceholder(){ return shMode==='ca'?'Paste a recent event/news, e.g. "new RBI monetary policy"':'e.g. Fundamental Rights, El Niño, Fiscal Deficit'; }
function loadStudyHub(){
  const el=document.getElementById('studyhub-content');
  el.innerHTML=`<div class="card">
      <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.9rem">
        ${SH_MODES.map(m=>`<button class="sh-mode ${shMode===m[0]?'active':''}" id="shmode-${m[0]}" onclick="shSetMode('${m[0]}')">${m[1]}</button>`).join('')}
      </div>
      <div class="form-group"><label id="sh-label">${shMode==='ca'?'Recent event / news topic':'Topic / concept'}</label>
        <input id="sh-topic" placeholder="${shPlaceholder()}" onkeydown="if(event.key==='Enter')shGenerate()"></div>
      <div id="sh-subject-wrap" class="form-group" style="${shMode==='ca'?'display:none':''}"><label>Subject (optional)</label>
        <input id="sh-subject" placeholder="e.g. Polity, Environment"></div>
      <button class="btn btn-primary" id="sh-go" onclick="shGenerate()">✨ Generate</button>
    </div>
    <div id="sh-output"></div>`;
}
function shSetMode(m){
  shMode=m;
  SH_MODES.forEach(x=>{const b=document.getElementById('shmode-'+x[0]); if(b) b.classList.toggle('active',x[0]===m);});
  const lbl=document.getElementById('sh-label'); if(lbl) lbl.textContent=(m==='ca')?'Recent event / news topic':'Topic / concept';
  const tp=document.getElementById('sh-topic'); if(tp) tp.placeholder=shPlaceholder();
  const sw=document.getElementById('sh-subject-wrap'); if(sw) sw.style.display=(m==='ca')?'none':'';
  const o=document.getElementById('sh-output'); if(o) o.innerHTML='';
}
async function shGenerate(){
  const topic=document.getElementById('sh-topic').value.trim();
  if(!topic){ alert('Enter a topic first.'); return; }
  const se=document.getElementById('sh-subject'); const subject=se?se.value.trim():'';
  const out=document.getElementById('sh-output');
  const go=document.getElementById('sh-go'); go.disabled=true; const og=go.innerHTML; go.innerHTML='<span class="spinner"></span> Generating...';
  out.innerHTML='<div class="card"><span class="spinner" style="color:var(--accent)"></span> Working on it… (a few seconds)</div>';
  try{
    if(shMode==='notes'){ const d=await api('/content/notes','POST',{topic,subject}); out.innerHTML=`<div class="card">${mdToHtml(d.notes||'')}</div>`; }
    else if(shMode==='mnemonics'){ const d=await api('/content/mnemonics','POST',{topic,subject}); out.innerHTML=`<div class="card">${mdToHtml(d.mnemonics||'')}</div>`; }
    else if(shMode==='flashcards'){ const d=await api('/content/flashcards','POST',{topic,subject,count:12}); out.innerHTML=renderFlashcards(d.cards||[]); }
    else if(shMode==='mindmap'){ const d=await api('/content/mindmap','POST',{topic,subject}); out.innerHTML=`<div class="card"><ul class="mind-tree">${renderMindNode(d.tree,true)}</ul></div>`; }
    else if(shMode==='ca'){ const d=await api('/content/current-affairs','POST',{event:topic}); shLastCA=topic;
      out.innerHTML=`<div class="card">${mdToHtml(d.analysis||'')}</div>
        <div style="margin-top:0.8rem"><button class="btn btn-secondary btn-sm" onclick="shCAPractice()">🎯 Generate practice MCQs on this</button></div>`; }
  }catch(e){ out.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`; }
  go.disabled=false; go.innerHTML=og;
}
function renderFlashcards(cards){
  if(!cards.length) return '<div class="alert alert-error">No cards generated. Try again.</div>';
  return `<div style="color:var(--muted);font-size:0.82rem;margin:0.5rem 0 0.7rem">${cards.length} cards · tap a card to flip.</div>
    <div class="fc-grid">${cards.map(c=>`<div class="flashcard" onclick="this.classList.toggle('flipped')">
      <div class="fc-front"><div style="font-weight:600">${esc(c.front)}</div><div style="font-size:0.68rem;color:var(--muted);margin-top:0.5rem">tap to reveal</div></div>
      <div class="fc-back">${esc(c.back)}</div></div>`).join('')}</div>`;
}
function renderMindNode(node,root){
  if(!node) return '';
  const kids=(node.children||[]).map(c=>renderMindNode(c,false)).join('');
  return `<li class="${root?'mind-root':''}"><span class="mind-node">${esc(node.title||'')}</span>${kids?`<ul>${kids}</ul>`:''}</li>`;
}
async function shCAPractice(){
  if(!shLastCA) return;
  try{
    const r=await api('/mock-tests/generate-verified/','POST',{subject:'Current Affairs',topic:shLastCA,num_questions:5,difficulty:'medium',question_type:'all'});
    startTest(r.mock_test_id,'Current Affairs • '+shLastCA,r.duration_minutes||5);
  }catch(e){ alert(emsg(e)||'Could not generate practice questions.'); }
}

// ── Revision (spaced repetition) ──────────────────────────────────────────────
let revisionQuestions=[];
let revisionAnswers={};
let revisionConf={};
function revCalendarHtml(cal){
  if(!cal||!cal.days) return '';
  const max=Math.max(1,...cal.days.map(d=>d.count));
  return `<div class="card" style="margin-bottom:1rem">
    <div style="font-weight:600;margin-bottom:0.6rem">🗓️ Next 14 days${cal.overdue?` · <span style="color:var(--danger)">${cal.overdue} overdue</span>`:''}</div>
    <div style="display:flex;align-items:flex-end;gap:4px;height:64px">
      ${cal.days.map(d=>{const h=d.count?Math.max(10,d.count/max*100):4; const c=d.is_today?'var(--accent)':(d.count?'var(--info)':'var(--border)');
        return `<div title="${d.label}: ${d.count} due" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;height:100%;justify-content:flex-end">
          <div style="width:100%;height:${h}%;background:${c};border-radius:3px"></div>
          <div style="font-size:0.6rem;color:var(--muted)">${d.label.split(' ')[1]||''}</div></div>`;}).join('')}
    </div></div>`;
}
async function loadRevision(){
  const el=document.getElementById('revision-content');
  el.innerHTML='<div class="empty"><div class="spinner"></div></div>';
  try{
    const [d,cal]=await Promise.all([api('/me/revision/due'),api('/me/revision/calendar').catch(()=>null)]);
    updateRevBadge(d.due_count);
    const calHtml=revCalendarHtml(cal);
    if(!d.due_count){
      el.innerHTML=calHtml+`<div class="card" style="text-align:center;padding:2rem">
        <div style="font-size:2rem">✅</div>
        <div style="font-weight:600;margin-top:0.5rem">Nothing due right now.</div>
        <div style="color:var(--muted);font-size:0.88rem;margin-top:0.4rem">
          ${d.total_scheduled?`${d.total_scheduled} question(s) scheduled for later`:'Questions you miss in tests will appear here'} · ${d.mastered} mastered 🏆
        </div>
      </div>`;
      return;
    }
    revisionQuestions=d.questions; revisionAnswers={}; revisionConf={};
    el.innerHTML=calHtml+`<div class="card" style="margin-bottom:1rem;display:flex;align-items:center;gap:0.8rem">
        <span style="font-size:1.4rem">🔁</span>
        <div><div style="font-weight:600">${d.due_count} question${d.due_count>1?'s':''} due for review</div>
        <div style="color:var(--muted);font-size:0.82rem">${d.mastered} mastered · ${d.total_scheduled} in your queue</div></div>
      </div>
      ${d.questions.map((q,i)=>`
        <div class="q-card">
          <div class="q-text"><strong>Q${i+1}.</strong> ${esc(q.text).replace(/\n/g,'<br>')}</div>
          <div class="options">
            ${['A','B','C','D'].map(l=>`<div class="opt" id="rev-${q.question_id}-${l}" onclick="pickRev(${q.question_id},'${l}')"><div class="opt-letter">${l}</div><div>${esc(q['option_'+l.toLowerCase()])}</div></div>`).join('')}
          </div>
          <div class="conf-row" id="revconf-${q.question_id}" style="display:none;align-items:center;gap:0.5rem;flex-wrap:wrap;margin-top:0.7rem;padding-top:0.6rem;border-top:1px dashed rgba(0,0,0,0.08)">
            <span style="font-size:0.78rem;color:var(--muted)">How sure?</span>
            <button type="button" class="conf-btn" id="revconf-${q.question_id}-sure" onclick="setRevConf(${q.question_id},'sure')">😎 Sure</button>
            <button type="button" class="conf-btn" id="revconf-${q.question_id}-unsure" onclick="setRevConf(${q.question_id},'unsure')">🤔 Unsure</button>
            <button type="button" class="conf-btn" id="revconf-${q.question_id}-guess" onclick="setRevConf(${q.question_id},'guess')">🎲 Guess</button>
          </div>
        </div>`).join('')}
      <div style="display:flex;align-items:center;gap:1rem;margin-top:1rem">
        <button class="btn btn-primary" onclick="submitRevision()">Submit Revision</button>
        <span id="rev-count" style="color:var(--muted);font-size:0.85rem">0 of ${d.due_count} answered</span>
      </div>
      <div id="revision-result"></div>`;
  }catch(e){ el.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`; }
}
function pickRev(qId,letter){
  revisionAnswers[qId]=letter;
  ['A','B','C','D'].forEach(l=>{const o=document.getElementById(`rev-${qId}-${l}`);if(o)o.classList.toggle('selected',l===letter);});
  const c=document.getElementById('rev-count'); if(c) c.textContent=`${Object.keys(revisionAnswers).length} of ${revisionQuestions.length} answered`;
  const cr=document.getElementById('revconf-'+qId); if(cr) cr.style.display='flex';
}
function setRevConf(qId,level){
  revisionConf[qId]=level;
  ['sure','unsure','guess'].forEach(l=>{const b=document.getElementById(`revconf-${qId}-${l}`);if(b)b.classList.toggle('active',l===level);});
}
async function submitRevision(){
  const answers=Object.entries(revisionAnswers).map(([q,opt])=>({question_id:parseInt(q),selected_option:opt,confidence:revisionConf[q]||null}));
  if(!answers.length){ alert('Answer at least one question.'); return; }
  try{
    const d=await api('/me/revision/submit','POST',answers);
    const out=document.getElementById('revision-result');
    const pct=d.total?Math.round(d.correct/d.total*100):0;
    const col=pct>=60?'var(--success)':pct>=40?'var(--accent)':'var(--danger)';
    out.innerHTML=`<div class="card" style="margin-top:1rem;text-align:center">
      <div style="font-size:1.6rem;font-weight:700;color:${col}">${d.correct}/${d.total} correct</div>
      <div style="color:var(--muted);font-size:0.85rem;margin-top:0.3rem">Schedules updated — correct answers move further out, misses come back sooner.</div>
      <button class="btn btn-secondary btn-sm" style="margin-top:1rem" onclick="loadRevision()">↻ Reload due questions</button>
    </div>`;
    out.scrollIntoView({behavior:'smooth',block:'center'});
    refreshLearningCards();
  }catch(e){ alert(emsg(e)); }
}
function updateRevBadge(n){
  const b=document.getElementById('rev-badge');
  if(!b) return;
  if(n>0){ b.textContent=n; b.style.display='inline-block'; } else { b.style.display='none'; }
}
async function refreshLearningCards(){
  try{
    const d=await api('/me/learning/summary');
    updateRevBadge(d.due_revisions);
    const set=(id,v)=>{const el=document.getElementById(id);if(el)el.textContent=v;};
    set('lc-mistakes',d.mistakes); set('lc-due',d.due_revisions); set('lc-mastered',d.mastered);
    const card=document.getElementById('learning-cards');
    if(card) card.style.display=(d.mistakes||d.due_revisions||d.mastered)?'grid':'none';
  }catch(e){}
}

