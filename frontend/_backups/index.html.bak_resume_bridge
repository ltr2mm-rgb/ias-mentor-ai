// Derive an official NCERT chapter PDF from the book's zip code, so it can be read
// INSIDE the app. The raw read_url is a whole-book .zip (which the browser just
// downloads); the per-chapter PDFs live at <code><NN>.pdf.
// Books uploaded to our own Google Cloud Storage bucket (whole-book PDFs).
// These open directly in the in-app reader — no dependency on ncert.nic.in.
// Fetched DIRECTLY from our public GCS bucket by PDF.js (bucket has CORS for our
// origin). GCS supports byte ranges natively with no size limit, so even 100 MB+
// books page in smoothly. Rendered onto a canvas, so Chrome's "download PDFs"
// setting never turns it into a download.
const _NCERT_GCS_BASE='https://storage.googleapis.com/aivora-production-ncert-books/';
const _NCERT_GCS_KEYS={'hist6_our_pasts_1':1,'hist7_our_pasts_2':1,'hist8_our_pasts_3':1,'hist9_contemporary_world_1':1,'hist10_contemporary_world_2':1,'hist11_themes_world':1,'hist12_themes_1':1,'hist12_themes_2':1,'hist12_themes_3':1,'hist_old_ancient':1,'hist_old_medieval':1,'hist_old_modern':1,'art11_indian_art':1,'art12_living_craft':1,'pol9_democratic_politics_1':1,'pol10_democratic_politics_2':1,'pol11_constitution_at_work':1,'pol11_political_theory':1,'pol12_contemporary_world_politics':1,'pol12_politics_since_independence':1,'geo6_earth_habitat':1,'geo7_our_environment':1,'geo8_resources_development':1,'geo9_contemporary_india_1':1,'geo10_contemporary_india_2':1,'geo11_physical':1,'geo11_india_physical':1,'geo12_human':1,'geo12_india_people_economy':1,'eco9_economics':1,'eco10_understanding_dev':1,'eco11_indian_dev':1,'eco12_micro':1,'eco12_macro':1,'sci8_science':1,'sci9_science':1,'sci10_science':1,'sci_senior_chemistry':1,'sci_senior_biology':1,'env12_biology_ecology':1,'soc6_social_political_1':1,'soc7_social_political_2':1,'soc8_social_political_3':1,'soc11_understanding_society':1,'soc12_indian_society':1,'soc12_social_change':1,'hist_old_ancient_thapar':1,'hist_old_ancient_makkhan':1,'hist_old_medieval_thapar':1,'hist_old_civ_1':1,'hist_old_civ_2':1,'nios_history':1,'nios_indian_culture':1,'nios_geography':1,'nios_geography_sr':1,'nios_economics':1,'nios_polity':1,'nios_polity_sr':1,'nios_biology':1,'nios_chemistry':1,'nios_physics':1,'art12_craft_traditions':1,'chem11_part2':1,'chem12_part1':1,'chem12_part2':1,'phy11_part1':1,'phy11_part2':1,'phy12_part1':1,'phy12_part2':1,'psy11':1,'psy12':1,'sci6_science':1,'sci7_science':1,'sci9_exemplar':1,'soc11_introducing_sociology':1};
function ncertGcsUrl(key){ return (key && _NCERT_GCS_KEYS[key]) ? (_NCERT_GCS_BASE+key+'.pdf') : ''; }
// Upgrade any book reference to our hosted full-book copy when we have one.
// Prefer an explicit book key; else match a loaded book by its read_url. Never
// makes things worse — an unmatched url passes straight through.
function resolveBookPdf(url, bookKey){
  const g=ncertGcsUrl(bookKey); if(g) return g;
  if(url && Array.isArray(_ncertBooks)){
    const b=_ncertBooks.find(x=>x&&x.read_url&&x.read_url===url);
    if(b){ const g2=ncertGcsUrl(b.key); if(g2) return g2; }
  }
  return url;
}
function ncertChapterPdfUrl(book, chapterIdx){
  const ru=(book&&book.read_url)||'';
  if(chapterIdx<0) chapterIdx=0;
  const nn=String(chapterIdx+1).padStart(2,'0');
  let m=ru.match(/^archive:(?:ncert-)?([a-z0-9]+)$/i);
  if(m) return 'https://ncert.nic.in/textbook/pdf/'+m[1].toLowerCase()+nn+'.pdf';
  m=ru.match(/^(https?:\/\/.*\/pdf\/)([a-z0-9]+?)dd\.zip$/i);
  if(m) return m[1]+m[2]+nn+'.pdf';
  if(/^https:\/\/ncert\.nic\.in\/textbook\/pdf\/[a-z0-9]+\.pdf$/i.test(ru)) return ru;
  return '';
}
