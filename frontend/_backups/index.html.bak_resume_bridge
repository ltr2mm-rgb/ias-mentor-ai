    _prac={exam, year, mock_test_id:d.mock_test_id,
           title:d.title||((exam==='csat'?'CSAT':'GS')+' PYQ • '+year),
           qs:d.questions, i:0, picks:{}, saved:false};
    renderPractice();
  }catch(e){ el.innerHTML=`<div class="alert alert-error">${emsg(e)}</div><button class="btn btn-secondary" style="margin-top:1rem" onclick="showPanel('pyq')">← Back</button>`; }
}
// Record answered items so wrong ones feed Mistakes + Revision (same path as a test).
async function pracSave(){
  if(!_prac || _prac.saved) return;
  const answers=Object.values(_prac.picks)
    .filter(p=>p && p.qid)
    .map(p=>({question_id:p.qid, selected_option:p.letter, confidence:null, time_taken:null}));
  if(!answers.length){ _prac.saved=true; return; }
  try{ await api(`/mock-tests/${_prac.mock_test_id}/submit/`,'POST',answers); _prac.saved=true; }
  catch(e){ /* keep practising even if saving fails */ }
}
async function _pracExit(){
  const answered=_prac?Object.keys(_prac.picks).length:0;
  if(answered && !confirm('Exit practice? Your '+answered+' answered question'+(answered>1?'s':'')+' will be saved to Review.')) return;
  await pracSave();
  _prac=null; showPanel('pyq');
}
function renderPractice(){
  if(!_prac) return;
  const {qs,i,picks}=_prac; const q=qs[i]; const N=qs.length;
  const done=Object.keys(picks).length;
  const correct=Object.values(picks).filter(p=>p.correct).length;
  const picked=picks[i]; const ans=(q.correct_answer||'').toUpperCase();
  const opts=['A','B','C','D'].map(l=>{
    let cls='opt';
    if(picked){
      if(l===ans) cls+=' correct';
      else if(l===picked.letter) cls+=' wrong';
    }
    const onclick = picked ? '' : ` onclick="pracPick('${l}')"`;
    const cur=(!picked && false);
    return `<div class="${cls}" style="cursor:${picked?'default':'pointer'}"${onclick}>
        <div class="opt-letter">${l}</div><div>${esc(q['option_'+l.toLowerCase()]||'')}</div>
      </div>`;
  }).join('');
  let feedback='';
  if(picked){
    const ok=picked.correct;
    feedback=`<div style="margin-top:1rem;padding:0.85rem 1rem;border-radius:10px;border:1px solid ${ok?'var(--success)':'var(--danger)'};background:${ok?'rgba(46,204,113,0.08)':'rgba(231,76,60,0.08)'}">
        <div style="font-weight:700;color:${ok?'var(--success)':'var(--danger)'};margin-bottom:${q.explanation?'0.4rem':'0'}">${ok?'✅ Correct':'❌ Incorrect — correct answer is '+ans}</div>
        ${q.explanation?`<div style="font-size:0.9rem;line-height:1.6;color:var(--text)">${esc(q.explanation).replace(/\n/g,'<br>')}</div>`:''}
      </div>`;
  }
  const pct=Math.round((done/N)*100);
  document.getElementById('practice-ui').innerHTML=`
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.9rem;gap:0.5rem;flex-wrap:wrap">
      <div style="font-weight:600;font-size:1.05rem">${esc(_prac.title)} <span style="color:var(--muted);font-weight:500;font-size:0.85rem">· one by one</span></div>
      <button class="btn btn-secondary btn-sm" onclick="_pracExit()">✕ Exit</button>
    </div>
    <div style="display:flex;align-items:center;gap:0.8rem;margin-bottom:1rem;font-size:0.85rem;color:var(--muted)">
      <span>Question <strong style="color:var(--text)">${i+1}</strong> of ${N}</span>
      <span>·</span>
      <span>✅ ${correct} correct / ${done} attempted</span>
    </div>
    <div class="prog-wrap" style="margin-bottom:1.1rem"><div class="prog-bar" style="width:${pct}%"></div></div>
    <div class="q-card">
      <div class="q-text"><strong>Q${i+1}.</strong> ${esc(q.text||'').replace(/\n/g,'<br>')}</div>
      <div class="options">${opts}</div>
      ${feedback}
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-top:1rem;flex-wrap:wrap">
      <button class="btn btn-secondary btn-sm" ${i===0?'disabled':''} onclick="pracNav(-1)">← Previous</button>
      ${ i<N-1
          ? `<button class="btn btn-primary btn-sm" onclick="pracNav(1)">Next →</button>`
          : `<button class="btn btn-primary btn-sm" onclick="pracFinish()">Finish ✓</button>` }
    </div>`;
  try{ window.scrollTo(0,0); }catch(e){}
}
function pracPick(letter){
  if(!_prac || _prac.picks[_prac.i]) return;
  const q=_prac.qs[_prac.i]; const ans=(q.correct_answer||'').toUpperCase();
  _prac.picks[_prac.i]={letter, correct:(letter===ans), qid:q.id};
  _prac.saved=false;  // a new answer since last save
  renderPractice();
}
function pracNav(delta){
  if(!_prac) return;
  _prac.i=Math.max(0,Math.min(_prac.qs.length-1,_prac.i+delta));
  renderPractice();
}
async function pracFinish(){
  if(!_prac) return;
  const {qs,picks,title,exam,year}=_prac; const N=qs.length;
  const done=Object.keys(picks).length;
  const correct=Object.values(picks).filter(p=>p.correct).length;
  const wrong=done-correct;
  const pct=done?Math.round((correct/done)*100):0;
  await pracSave();
  const saveNote = done
    ? `<div style="font-size:0.85rem;color:var(--muted);margin-bottom:1.1rem">📌 Saved to your tracker — ${wrong>0?`${wrong} missed question${wrong>1?'s':''} added to <strong>Mistakes</strong> &amp; <strong>Revision</strong>.`:'no mistakes this round. Nicely done!'}</div>`
    : '';
  document.getElementById('practice-ui').innerHTML=`
    <div class="card" style="max-width:560px;margin:1.5rem auto;text-align:center">
      <div style="font-size:2.2rem">🎯</div>
      <div style="font-weight:800;font-size:1.25rem;margin-top:0.3rem">${esc(title)} — practice complete</div>
      <div style="color:var(--muted);font-size:0.95rem;margin:0.6rem 0 0.6rem">
        You attempted <strong>${done}</strong> of ${N} and got <strong style="color:var(--success)">${correct}</strong> right${done?` (${pct}%)`:''}.
      </div>
      ${saveNote}
      <div style="display:flex;gap:0.5rem;justify-content:center;flex-wrap:wrap">
        <button class="btn btn-primary" onclick="startPractice('${exam}','${year}')">🔁 Restart</button>
        ${wrong>0?`<button class="btn btn-secondary" onclick="_prac=null;showPanel('mistakes')">📕 Review mistakes</button>`:''}
        <button class="btn btn-secondary" onclick="_prac=null;showPanel('pyq')">← Back to PYQs</button>
      </div>
    </div>`;
  try{ window.scrollTo(0,0); }catch(e){}
}

