<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/theme.aim.css">
<title>AIMENTORA — AI-based IAS Mentor</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<script>try{if(localStorage.getItem('ias_token'))document.documentElement.setAttribute('data-authed','1');else document.documentElement.classList.add('show-landing');}catch(e){}</script>
<style>html.show-landing #page-dashboard,html.show-landing #page-auth{display:none!important;}html.show-landing #page-landing{display:block!important;}html:not(.show-landing) #page-landing{display:none;}html.show-landing body,html.show-auth body{padding-right:0!important;}html.show-landing nav,html.show-auth nav{margin-right:0!important;}</style>
<style>
:root{--bg:#faf3ee;--surface:#ffffff;--surface2:#f6ebe4;--border:#ecdcd3;--accent:#8a1c24;--accent-d:#6f151c;--gold:#c69433;--gold-l:#e6b84e;--text:#2a2530;--muted:#857c82;--success:#1f9d57;--danger:#d93a3a;--info:#2f6fdb;--dock-w:380px;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}
nav{background:var(--surface);border-bottom:1px solid var(--border);padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:60px;position:sticky;top:0;z-index:100;}
.nav-logo{display:inline-flex;align-items:center;font-family:'Sora','Playfair Display',serif;font-weight:800;font-size:1.3rem;letter-spacing:.01em;}
.nav-logo .lg-ai{color:var(--gold);}
.nav-logo .lg-rest{color:var(--accent);}
.nav-logo span{color:var(--text);}
.nav-right{display:flex;align-items:center;gap:1rem;font-size:0.85rem;color:var(--muted);}
.page{display:none;} .page.active{display:block;}
#mentor-fab{display:flex!important;}@media(max-width:768px){#mentor-resize{display:none;}}#mentor-resize:hover,#mentor-resize:active{background:rgba(198,148,51,.45);}
body{transition:padding-right .25s ease;}
@media(min-width:769px){nav{transition:margin-right .25s ease;}}
.auth-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;background:radial-gradient(ellipse at 50% 0%,rgba(245,166,35,0.08),transparent 60%);}
.auth-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2.5rem;width:100%;max-width:440px;}
.auth-title{font-family:'Playfair Display',serif;font-size:2rem;color:var(--accent);margin-bottom:0.3rem;}
.auth-sub{color:var(--muted);font-size:0.9rem;margin-bottom:2rem;}
.auth-split{min-height:100vh;display:grid;grid-template-columns:1.05fr 1fr;}
.auth-hero{position:relative;display:flex;align-items:center;justify-content:center;padding:3rem;overflow:hidden;background:linear-gradient(160deg,#171c2b 0%,#0e1220 55%,#1c1426 100%);}
.auth-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 28% 18%,rgba(245,166,35,0.20),transparent 55%),radial-gradient(ellipse at 82% 88%,rgba(99,102,241,0.16),transparent 52%);}
.auth-hero-inner{position:relative;max-width:460px;}
.auth-badge{display:inline-block;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);border:1px solid rgba(245,166,35,0.35);border-radius:99px;padding:0.25rem 0.7rem;margin-bottom:1.1rem;}
.auth-brand{font-family:'Playfair Display',serif;font-size:2.6rem;font-weight:700;color:#fff;line-height:1.1;}#page-auth .auth-brand .brand-img{width:236px;height:51px;margin:.1rem 0}
.auth-brand span{color:var(--accent);}
.auth-tagline{color:#c9d2e3;font-size:1.08rem;margin:0.7rem 0 1.9rem;line-height:1.55;}
.auth-features{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.95rem;}
.auth-features li{color:#e7ebf3;font-size:0.95rem;line-height:1.45;display:flex;gap:0.6rem;align-items:flex-start;}
.auth-features li span{font-size:1.05rem;}
.auth-trust{margin-top:2rem;color:#8c93a6;font-size:0.82rem;}
.auth-formside{display:flex;align-items:center;justify-content:center;padding:2rem;background:radial-gradient(ellipse at 50% 0%,rgba(245,166,35,0.06),transparent 60%);}
.req{color:var(--accent);}
.auth-brandsub{color:var(--accent);font-size:0.95rem;letter-spacing:0.04em;margin-top:0.2rem;font-weight:600;}
.auth-stats{display:flex;gap:1.6rem;margin-top:1.9rem;flex-wrap:wrap;}
.auth-stats>div{display:flex;flex-direction:column;}
.auth-stats b{color:#fff;font-size:1.3rem;font-weight:700;line-height:1;}
.auth-stats span{color:#8c93a6;font-size:0.72rem;margin-top:0.25rem;}
.auth-link{color:var(--accent);font-size:0.85rem;text-decoration:none;}
.auth-link:hover{text-decoration:underline;}
@media(max-width:860px){
  .auth-split{grid-template-columns:1fr;}
  .auth-hero{padding:2rem 1.5rem;min-height:auto;}
  .auth-brand{font-size:2rem;}
  .auth-tagline{font-size:0.98rem;margin-bottom:0;}
  .auth-features,.auth-trust,.auth-stats{display:none;}
  .auth-formside{padding:1.25rem;}
}
.auth-tabs{display:flex;margin-bottom:2rem;border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.auth-tab{flex:1;padding:0.6rem;text-align:center;cursor:pointer;font-size:0.9rem;color:var(--muted);background:transparent;border:none;transition:all 0.2s;}
.auth-tab.active{background:var(--accent);color:#fff;font-weight:600;}
.form-group{margin-bottom:1.2rem;}
label{display:block;font-size:0.8rem;color:var(--muted);margin-bottom:0.4rem;text-transform:uppercase;letter-spacing:0.05em;}
input,textarea,select{width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;border-radius:8px;font-size:0.95rem;font-family:'Inter',sans-serif;transition:border-color 0.2s;outline:none;}
input[type=checkbox],input[type=radio]{width:auto;min-width:0;height:auto;padding:0;accent-color:var(--accent);cursor:pointer;}
/* Syllabus tracker topic rows: override the global form label/input styling */
#syllabus-tree label.syltopic{display:flex;align-items:flex-start;gap:0.55rem;padding:0.26rem 0;margin:0;cursor:pointer;font-size:0.9rem;text-transform:none;letter-spacing:normal;color:var(--text);font-weight:400;}
#syllabus-tree label.syltopic input[type=checkbox]{width:16px;min-width:16px;height:16px;flex:none;margin:0.2rem 0 0 0;padding:0;background:transparent;border-radius:3px;cursor:pointer;}
#syllabus-tree label.syltopic span{font-size:0.9rem;color:var(--text);line-height:1.45;}
#syllabus-tree label.syltopic span.done{opacity:0.5;text-decoration:line-through;}
input:focus,textarea:focus,select:focus{border-color:var(--accent);}
textarea{resize:vertical;min-height:80px;}
.btn{padding:0.75rem 1.5rem;border-radius:8px;font-size:0.9rem;font-weight:500;cursor:pointer;border:none;transition:all 0.2s;font-family:'Inter',sans-serif;}
.btn-primary{background:var(--accent);color:#fff;}
.btn-primary:hover{background:var(--accent-d);}
.btn-secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border);}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}
.btn-success{background:var(--success);color:#fff;}
.btn-danger{background:var(--danger);color:#fff;}
.btn-block{width:100%;}
.btn-sm{padding:0.35rem 0.8rem;font-size:0.8rem;}
.btn:disabled{opacity:0.5;cursor:not-allowed;}
.btn-logout{background:none;border:1px solid var(--border);color:var(--muted);padding:0.35rem 0.9rem;border-radius:6px;cursor:pointer;font-size:0.8rem;}
.btn-logout:hover{border-color:var(--danger);color:var(--danger);}
.dashboard{max-width:1680px;margin:0 auto;padding:2rem 2.4rem;}
.dash-layout{display:grid;grid-template-columns:220px 1fr;gap:2rem;}
.sidebar{display:flex;flex-direction:column;gap:0.25rem;position:sticky;top:76px;align-self:start;max-height:calc(100vh - 92px);overflow-y:auto;}
.sidebar-item{display:flex;align-items:center;gap:0.75rem;padding:0.65rem 1rem;border-radius:8px;cursor:pointer;color:var(--muted);font-size:0.88rem;transition:all 0.2s;border:none;background:none;width:100%;text-align:left;}
.sidebar-item:hover{background:var(--surface2);color:var(--text);}
.sidebar-item.active{background:var(--surface2);color:var(--accent);border-left:3px solid var(--accent);}
.sidebar-icon{font-size:1rem;width:18px;}
.sidebar-divider{height:1px;background:var(--border);margin:0.5rem 0;}
.sidebar-group{font-size:0.66rem;text-transform:uppercase;letter-spacing:0.09em;color:var(--muted);opacity:0.65;margin:0.9rem 0 0.25rem 0.7rem;font-weight:600;}
.hub-tabs{display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1.4rem;border-bottom:1px solid var(--border);padding-bottom:0.85rem;}
.hub-tab{padding:0.45rem 0.95rem;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--muted);font-size:0.84rem;cursor:pointer;transition:all 0.15s;font-family:'Inter',sans-serif;}
.hub-tab:hover{color:var(--text);border-color:var(--accent);}
.hub-tab.active{background:var(--accent);color:#fff;border-color:var(--accent);font-weight:600;}
.menu-toggle{display:none;background:none;border:1px solid var(--border);color:var(--text);font-size:1.15rem;line-height:1;padding:0.35rem 0.65rem;border-radius:7px;cursor:pointer;margin-right:0.8rem;}
.sidebar-backdrop{display:none;}
@media(max-width:1279px){
  .dashboard{padding:1rem;}
  .dash-layout{grid-template-columns:1fr;}
  .menu-toggle{display:inline-flex;align-items:center;}
  .sidebar{position:fixed;top:0;left:0;height:100dvh;width:250px;background:var(--surface);border-right:1px solid var(--border);z-index:300;padding:1.2rem 1rem;transform:translateX(-100%);transition:transform 0.25s ease;overflow-y:auto;}
  .sidebar.open{transform:translateX(0);}
  .sidebar-backdrop.open{display:block;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:250;}
}
.nav-search-trigger{display:flex;align-items:center;gap:0.5rem;background:var(--surface2);border:1px solid var(--border);color:var(--muted);padding:0.4rem 0.8rem;border-radius:8px;cursor:pointer;font-size:0.85rem;font-family:'Inter',sans-serif;}
.nav-search-trigger:hover{border-color:var(--accent);color:var(--text);}
.nav-search-kbd{font-size:0.66rem;border:1px solid var(--border);border-radius:4px;padding:0.05rem 0.35rem;color:var(--muted);}
.palette-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:500;}
.palette-overlay.open{display:flex;justify-content:center;align-items:flex-start;padding-top:12vh;}
.palette-box{width:min(620px,92vw);background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,0.5);overflow:hidden;}
.palette-input{width:100%;border:none;border-bottom:1px solid var(--border);background:transparent;color:var(--text);font-size:1.05rem;padding:1rem 1.2rem;border-radius:0;}
.palette-input:focus{border-color:var(--border);border-bottom-color:var(--accent);}
.palette-results{max-height:52vh;overflow-y:auto;padding:0.4rem;}
.palette-item{display:flex;align-items:center;gap:0.7rem;padding:0.6rem 0.8rem;border-radius:8px;cursor:pointer;font-size:0.9rem;color:var(--text);}
.palette-item .pi-sub{margin-left:auto;font-size:0.72rem;color:var(--muted);}
.palette-item.active,.palette-item:hover{background:var(--surface2);}
.palette-empty{padding:1.2rem;color:var(--muted);font-size:0.88rem;text-align:center;}
.diag-box{width:min(640px,94vw);background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,0.5);padding:1.3rem;max-height:86vh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;}
.diag-nav{position:sticky;bottom:-1.3rem;margin:1.1rem -1.3rem -1.3rem;padding:0.8rem 1.3rem calc(1.3rem + env(safe-area-inset-bottom));background:var(--surface);border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
body.diag-open{overflow:hidden;}
@media (max-width:640px){
  #diag-overlay.palette-overlay.open{padding:0;align-items:stretch;justify-content:stretch;}
  #diag-overlay .diag-box{width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;border-radius:0;border:0;}
}
.diag-opt{text-align:left;background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:0.7rem 0.9rem;border-radius:8px;cursor:pointer;font-size:0.9rem;font-family:'Inter',sans-serif;min-height:48px;display:flex;align-items:center;line-height:1.4;}
.diag-opt:hover{border-color:var(--accent);}
.diag-opt.sel{border-color:var(--accent);background:rgba(138,28,36,0.10);}
.pdf-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:600;}
.pdf-overlay.open{display:flex;justify-content:center;align-items:stretch;padding:0;}
.pdf-shell{display:flex;align-items:stretch;gap:0;height:100vh;width:100vw;max-width:100vw;}
.pdf-box{position:relative;flex:1;width:100%;max-width:100%;height:100%;background:var(--surface);border:none;border-radius:0;display:flex;flex-direction:column;overflow:hidden;}
.pdf-bar{display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.9rem;border-bottom:1px solid var(--border);}
.pdf-frame{flex:1;width:100%;border:none;background:#fff;}
/* NCERT reader: highlights, text-selection layer, notes panel */
#pdf-canvas .pdfpage{position:relative;margin:0 auto 12px;}
#pdf-canvas .pdfpage canvas{display:block;box-shadow:0 2px 10px rgba(0,0,0,.45);background:#fff;}
#pdf-canvas .hl-layer{position:absolute;inset:0;pointer-events:none;}
#pdf-canvas .hl-mark{position:absolute;background:rgba(245,208,50,0.40);border-radius:2px;pointer-events:auto;cursor:pointer;mix-blend-mode:multiply;}
#pdf-canvas .hl-mark.hl-pulse{animation:hlpulse 0.8s ease-in-out 3;outline:2px solid #f59e0b;box-shadow:0 0 0 4px rgba(245,158,11,0.35);}
@keyframes hlpulse{0%,100%{background:rgba(245,208,50,0.40);}50%{background:rgba(245,158,11,0.85);}}
.textLayer{position:absolute;inset:0;overflow:hidden;line-height:1;opacity:1;}
.textLayer span{position:absolute;white-space:pre;color:transparent;transform-origin:0 0;cursor:text;}
.textLayer ::selection{background:rgba(245,208,50,0.55);}
.pdf-body{flex:1;display:flex;min-height:0;}
#pdf-canvas,#pdf-frame{flex:1;min-width:0;}
#reader-hint{display:none;position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(26,29,39,0.92);color:var(--muted);border:1px solid var(--border);padding:5px 14px;border-radius:20px;font-size:0.78rem;z-index:3;pointer-events:none;}
#reader-hint.show{display:block;}
#sel-toolbar{position:fixed;z-index:650;display:none;gap:4px;background:#1a1d27;border:1px solid var(--border);border-radius:8px;padding:4px;box-shadow:0 3px 12px rgba(0,0,0,.5);}
#sel-toolbar.open{display:flex;}
.sel-tb-btn{background:transparent;color:var(--text);border:none;border-radius:5px;padding:5px 10px;font-size:0.8rem;font-weight:600;cursor:pointer;white-space:nowrap;}
.sel-tb-btn:hover{background:var(--surface2);}
#reader-toast{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);background:var(--success);color:#fff;padding:7px 16px;border-radius:20px;font-size:0.82rem;font-weight:600;z-index:6;opacity:0;transition:opacity .25s;pointer-events:none;}
#reader-toast.show{opacity:1;}
#reader-notes{flex:none;width:0;height:100%;overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:12px;display:flex;flex-direction:column;transition:width .18s;}
#reader-notes.open{width:min(340px,90vw);}
#reader-notes .rn-head{padding:0.7rem 0.9rem;border-bottom:1px solid var(--border);font-weight:600;display:flex;align-items:center;gap:0.5rem;}
#reader-notes .rn-list{flex:1;overflow:auto;padding:0.7rem;}
#reader-notes .rn-add{padding:0.7rem;border-top:1px solid var(--border);}
.rn-item{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.5rem 0.6rem;margin-bottom:0.5rem;font-size:0.84rem;line-height:1.45;position:relative;}
.rn-item .rn-body{padding-right:64px;}
.rn-item .rn-actions>span{cursor:pointer;color:var(--muted);}
.rn-item .rn-actions>span:hover{color:var(--text);}
.rn-item .rn-del{cursor:pointer;color:var(--muted);font-size:0.9rem;}
.rn-item .rn-del:hover{color:var(--danger);}
@media(max-width:768px){.nav-search-text,.nav-search-kbd{display:none;}.nav-search-trigger{padding:0.4rem 0.6rem;}}
.panel{display:none;} .panel.active{display:block;}
.panel-title{font-size:1.15rem;font-weight:600;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem;}
.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.5rem;margin-bottom:1rem;}
.card-sm{padding:1rem;}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.2rem;text-align:center;}
.stat-num{font-size:1.8rem;font-weight:700;color:var(--accent);}
.stat-label{font-size:0.78rem;color:var(--muted);margin-top:0.25rem;}
.badge{display:inline-block;padding:0.2rem 0.6rem;border-radius:99px;font-size:0.73rem;font-weight:500;}
.badge-green{background:rgba(46,204,113,0.15);color:var(--success);}
.badge-red{background:rgba(231,76,60,0.15);color:var(--danger);}
.badge-amber{background:rgba(198,148,51,0.18);color:var(--gold-l);}
.badge-blue{background:rgba(59,130,246,0.15);color:var(--info);}
.alert{padding:0.9rem 1.2rem;border-radius:8px;font-size:0.88rem;margin-bottom:1rem;}
.alert-error{background:rgba(231,76,60,0.1);border:1px solid rgba(231,76,60,0.3);color:var(--danger);}
.alert-success{background:rgba(46,204,113,0.1);border:1px solid rgba(46,204,113,0.3);color:var(--success);}
.test-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:0.85rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
.test-info .title{font-weight:600;margin-bottom:0.3rem;}
.test-info .meta{font-size:0.8rem;color:var(--muted);display:flex;gap:0.75rem;flex-wrap:wrap;}
.test-actions{display:flex;gap:0.5rem;flex-shrink:0;}
.timer-bar{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1rem 1.5rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:1rem;}
.timer-val{font-size:1.5rem;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums;min-width:70px;}
.prog-wrap{height:6px;background:var(--border);border-radius:99px;flex:1;}
.prog-bar{height:100%;background:var(--accent);border-radius:99px;transition:width 1s linear;}
.q-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.5rem;margin-bottom:1rem;scroll-margin-top:80px;}
.q-num{font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;}
.q-text{font-size:0.97rem;line-height:1.65;margin-bottom:1.2rem;}
.options{display:flex;flex-direction:column;gap:0.5rem;}
.opt{display:flex;align-items:center;gap:0.75rem;padding:0.65rem 1rem;border:1px solid var(--border);border-radius:8px;cursor:pointer;transition:all 0.2s;font-size:0.92rem;}
.opt:hover{border-color:var(--accent);background:rgba(138,28,36,0.05);}
.opt.selected{border-color:var(--accent);background:rgba(138,28,36,0.09);}
.opt.correct{border-color:var(--success);background:rgba(46,204,113,0.08);}
.opt.wrong{border-color:var(--danger);background:rgba(231,76,60,0.08);}
.opt-letter{width:26px;height:26px;border-radius:50%;background:var(--surface2);display:flex;align-items:center;justify-content:center;font-size:0.78rem;font-weight:600;flex-shrink:0;}
.result-hero{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2.5rem;text-align:center;margin-bottom:1.5rem;}
.result-score{font-size:4rem;font-weight:700;font-family:'Playfair Display',serif;}
.result-pct{font-size:1.4rem;font-weight:600;margin-top:0.25rem;}
.explanation{margin-top:0.75rem;padding:0.75rem 1rem;background:var(--bg);border-radius:6px;font-size:0.97rem;line-height:1.65;color:var(--text);border-left:3px solid var(--accent);}
.chat-wrap{display:flex;flex-direction:column;height:520px;}
.chat-msgs{flex:1;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:12px 12px 0 0;}
.msg{max-width:78%;padding:0.7rem 1rem;border-radius:12px;font-size:0.88rem;line-height:1.6;}
.msg-user{background:var(--accent);color:#fff;align-self:flex-end;border-radius:12px 12px 0 12px;}
.msg-ai{background:var(--surface2);align-self:flex-start;border-radius:12px 12px 12px 0;}
.msg-thinking{color:var(--muted);font-style:italic;}
.chat-row{display:flex;border:1px solid var(--border);border-top:none;border-radius:0 0 12px 12px;overflow:hidden;}
.chat-row input{border:none;border-radius:0;padding:0.9rem 1rem;background:var(--surface);flex:1;font-size:0.9rem;}
.chat-row input:focus{border:none;}
.chat-send{background:var(--accent);color:#fff;border:none;padding:0 1.3rem;cursor:pointer;font-weight:700;font-size:1rem;}
.chat-send:hover{background:var(--accent-d);}
.gen-out{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:1.2rem;font-size:0.86rem;line-height:1.85;white-space:pre-wrap;max-height:420px;overflow-y:auto;margin-top:1rem;}
.leaderboard-table{width:100%;border-collapse:collapse;}
.leaderboard-table th{text-align:left;padding:0.75rem 1rem;font-size:0.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;border-bottom:1px solid var(--border);}
.leaderboard-table td{padding:0.85rem 1rem;border-bottom:1px solid rgba(46,50,72,0.5);font-size:0.88rem;}
.leaderboard-table tr.me td{background:rgba(138,28,36,0.06);color:var(--accent);}
.rank-badge{width:28px;height:28px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:0.78rem;font-weight:700;}
.rank-1{background:gold;color:#000;}
.rank-2{background:silver;color:#000;}
.rank-3{background:#cd7f32;color:#fff;}
.rank-other{background:var(--surface2);color:var(--muted);}
.progress-ring{display:flex;align-items:center;justify-content:center;gap:1.5rem;flex-wrap:wrap;padding:1rem 0;}
.ring-item{text-align:center;}
.ring-label{font-size:0.78rem;color:var(--muted);margin-top:0.4rem;}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:200;align-items:center;justify-content:center;padding:1rem;}
.modal-bg.open{display:flex;}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2rem;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;}
.modal-title{font-size:1.1rem;font-weight:600;margin-bottom:1.5rem;}
.modal-actions{display:flex;gap:0.75rem;margin-top:1.5rem;justify-content:flex-end;}
.toggle-row{display:flex;align-items:center;justify-content:space-between;padding:0.75rem 0;border-top:1px solid var(--border);margin-top:0.5rem;}
.toggle-label{font-size:0.9rem;}
.toggle{position:relative;width:44px;height:24px;}
.toggle input{opacity:0;width:0;height:0;}
.toggle-slider{position:absolute;inset:0;background:var(--border);border-radius:99px;cursor:pointer;transition:0.3s;}
.toggle-slider:before{content:'';position:absolute;height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:0.3s;}
.toggle input:checked+.toggle-slider{background:var(--accent);}
.toggle input:checked+.toggle-slider:before{transform:translateX(20px);}
.empty{text-align:center;padding:3rem 1rem;color:var(--muted);}
.empty-icon{font-size:2.5rem;margin-bottom:0.75rem;}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,0.2);border-top-color:currentColor;border-radius:50%;animation:spin 0.7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px;}
.chart-bar-wrap{margin-top:0.75rem;}
.chart-bar-row{display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;font-size:0.82rem;}
.chart-bar-label{width:120px;color:var(--muted);flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.chart-bar-bg{flex:1;height:8px;background:var(--border);border-radius:99px;overflow:hidden;}
.chart-bar-fill{height:100%;border-radius:99px;background:var(--accent);transition:width 0.6s ease;}
.chart-bar-val{width:40px;text-align:right;color:var(--text);}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
.conf-btn{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:99px;padding:0.32rem 0.7rem;font-size:0.78rem;cursor:pointer;transition:all .15s;}
.conf-btn:hover{border-color:var(--accent);}
.conf-btn.active{background:var(--accent);border-color:var(--accent);color:#fff;}
.nav-badge{background:var(--danger);color:#fff;border-radius:99px;font-size:0.68rem;font-weight:700;padding:0.05rem 0.42rem;margin-left:0.35rem;}
.sim-layout{display:grid;grid-template-columns:1fr 300px;gap:1rem;align-items:start;}
.omr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(36px,1fr));gap:6px;}
.omr-cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:0.8rem;cursor:pointer;border:1px solid var(--border);background:var(--bg);color:var(--text);position:relative;font-weight:600;}
.omr-cell.cur{outline:2px solid var(--accent);outline-offset:1px;}
.omr-cell.ans{background:var(--success);color:#fff;border-color:var(--success);}
.omr-cell.notans{background:var(--danger);color:#fff;border-color:var(--danger);}
.omr-cell.marked{background:#7c3aed;color:#fff;border-color:#7c3aed;}
.omr-cell.ansmarked{background:#7c3aed;color:#fff;border-color:#7c3aed;}
.omr-cell.ansmarked::after{content:'';position:absolute;bottom:3px;right:3px;width:7px;height:7px;border-radius:50%;background:var(--success);border:1px solid #fff;}
.sim-timer{font-variant-numeric:tabular-nums;font-weight:700;}
.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.8rem;}
.flashcard{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1rem;min-height:120px;cursor:pointer;display:flex;align-items:center;justify-content:center;text-align:center;transition:border-color .15s;}
.flashcard:hover{border-color:var(--accent);}
.flashcard .fc-back{display:none;}
.flashcard.flipped .fc-front{display:none;}
.flashcard.flipped .fc-back{display:block;}
.flashcard .fc-hint{position:absolute;}
.mind-tree,.mind-tree ul{list-style:none;margin:0;padding-left:1.1rem;}
.mind-tree li{position:relative;padding:0.25rem 0 0.25rem 0.9rem;}
.mind-tree li::before{content:'';position:absolute;left:0;top:0.95rem;width:0.6rem;height:1px;background:var(--border);}
.mind-tree>li::before{display:none;}
.mind-node{display:inline-block;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.3rem 0.7rem;font-size:0.85rem;}
.mind-root>.mind-node{background:var(--accent);color:#fff;border-color:var(--accent);font-weight:600;}
.sh-mode{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:99px;padding:0.4rem 0.9rem;font-size:0.84rem;cursor:pointer;}
.sh-mode.active{background:var(--accent);border-color:var(--accent);color:#fff;}
@media(max-width:768px){.sim-layout{grid-template-columns:1fr;}}
@media(max-width:768px){.dash-layout{grid-template-columns:1fr;}.stats-grid{grid-template-columns:1fr 1fr;}.two-col{grid-template-columns:1fr;}#learning-cards{grid-template-columns:1fr 1fr !important;}}
</style>
