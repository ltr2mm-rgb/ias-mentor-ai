async function gspStartPractice(mid){
  const box=document.getElementById('gsp-practice'); if(!box) return;
  box.innerHTML='<div class="gsp-card">Loading questions…</div>';
  let d; try{ d=await api('/me/programme/module/'+mid+'/practice?n=10'); }catch(e){ if(e.message==='__AUTH__')return; box.innerHTML='<div class="gsp-card" style="color:#c00">'+_gspEsc(e.message)+'</div>'; return; }
  GSP_Q=d.questions||[]; GSP_I=0;
  if(!GSP_Q.length){ box.innerHTML='<div class="gsp-card">No questions available for this module yet.</div>'; return; }
  gspShowQ();
}
function gspShowQ(){
  const box=document.getElementById('gsp-practice');
  if(GSP_I>=GSP_Q.length){ box.innerHTML='<div class="gsp-card"><b>Set complete.</b> <button class="gsp-btn" onclick="gspPromote()">Check the gate →</button> <button class="gsp-btn2" onclick="gspStartPractice(GSP_MOD)">More practice</button></div>'; return; }
  const q=GSP_Q[GSP_I], opts=[['A',q.option_a],['B',q.option_b],['C',q.option_c],['D',q.option_d]];
  box.innerHTML='<div class="gsp-card"><div style="color:var(--muted);font-size:.72rem">Question '+(GSP_I+1)+' / '+GSP_Q.length+'</div>'+
    '<div style="font-weight:600;white-space:pre-line;margin:.4rem 0">'+_gspEsc(q.text)+'</div>'+
    '<div id="gsp-opts">'+opts.map(o=>'<button class="gsp-opt" onclick="gspAnswer(\''+o[0]+'\')">'+o[0]+'. '+_gspEsc(o[1])+'</button>').join('')+'</div>'+
    '<div id="gsp-fb"></div></div>';
}
async function gspAnswer(sel){
  const q=GSP_Q[GSP_I];
  document.querySelectorAll('.gsp-opt').forEach(b=>{b.disabled=true;});
  let r; try{ r=await api('/me/attempt','POST',{question_id:q.id,selected:sel,confidence:'sure',attempt_context:'programme'}); }catch(e){ document.getElementById('gsp-fb').innerHTML='<div style="color:#c00;margin-top:.4rem">'+_gspEsc(e.message)+'</div>'; return; }
  document.querySelectorAll('.gsp-opt').forEach(b=>{ if(b.textContent.trim().charAt(0)===sel){ b.style.borderColor=r.correct?'#16a34a':'#dc2626'; b.style.background=r.correct?'#dcfce7':'#fee2e2'; } });
  document.getElementById('gsp-fb').innerHTML='<div style="margin-top:.5rem;font-weight:600;color:'+(r.correct?'#16a34a':'#dc2626')+'">'+(r.correct?'✓ Correct':'✗ Not quite')+' · concept mastery now '+Math.round((r.mastery||0)*100)+'%</div>'+
    '<button class="gsp-btn" style="margin-top:.5rem" onclick="GSP_I++;gspShowQ()">Next →</button>';
}
async function gspPromote(){
  let r; try{ r=await api('/me/programme/promote','POST',{}); }catch(e){ if(e.message!=='__AUTH__')alert(e.message); return; }
  const box=document.getElementById('gsp-practice');
  if(r.promoted){
    if(box) box.innerHTML='<div class="gsp-card" style="border-left:4px solid #16a34a"><div style="font-size:1.15rem;font-weight:700">🏆 '+_gspEsc(r.message)+'</div><div style="color:var(--muted);font-size:.85rem;margin-top:.3rem">Returning to your journey…</div></div>';
    setTimeout(loadProgramme,1600);
  } else {
    alert(r.message||'Keep practising this module to clear the gate.');
    gspOpen(GSP_MOD||(r.module_id));
  }
}
