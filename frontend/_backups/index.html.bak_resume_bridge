    const d=await _apiRetry('/mock-tests/generate-verified/','POST',payload,2);
    if(d.questions_added>0){ _renderGenResult(d,payload,label,btn,outEl); }
    else{ outEl.innerHTML='<div class="alert alert-error">The AI couldn\'t produce a clean set just now. Please tap Generate again.</div>'; }
  }catch(e){ if(e.message==='__AUTH__'){ outEl.innerHTML=''; } else { outEl.innerHTML='<div class="alert alert-error">We couldn\'t build this set just now — the AI can be slow at peak times. Please tap Generate again.</div>'; } }
}
async function genVerified(payload, label, btn, outEl){
  const old=btn.innerHTML; btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Generating & verifying…';
  outEl.innerHTML='<div class="card"><span class="spinner" style="color:var(--accent)"></span> <span id="gv-prog">Preparing your set — '+esc(label)+'…</span></div>';
  if(!token){ openAuthModal('register'); outEl.innerHTML=''; btn.disabled=false; btn.innerHTML=old; return; }
  let streamed=false, final=null;
  try{
    const r=await fetch(API+'/mock-tests/generate-stream',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify(payload)});
    if(!r.ok||!r.body) throw new Error('stream_unavailable');
    streamed=true;
    const reader=r.body.getReader(), dec=new TextDecoder(); let buf='';
    while(true){
      const ch=await reader.read(); if(ch.done) break;
      buf+=dec.decode(ch.value,{stream:true});
      let idx;
      while((idx=buf.indexOf('\n\n'))>=0){
        const ln=buf.slice(0,idx).trim(); buf=buf.slice(idx+2);
        if(ln.indexOf('data:')!==0) continue;
        let ev; try{ ev=JSON.parse(ln.slice(5).trim()); }catch(_e){ continue; }
        const p=document.getElementById('gv-prog');
        if(ev.stage==='generating'){ if(p) p.textContent='Generating questions on '+label+'…'+(ev.target?(' (aiming for '+ev.target+')'):''); }
        else if(ev.stage==='verifying'){ if(p) p.textContent='Cross-checking answers for accuracy…'; }
        else if(ev.stage==='progress'){ if(p) p.textContent=(ev.have||0)+' of '+(ev.target||'?')+' verified — finishing up…'; }
        else if(ev.stage==='done'){ final=ev; }
        else if(ev.stage==='error'){ throw new Error(ev.detail||'gen_error'); }
      }
    }
  }catch(e){
    if(!streamed){ await _genVerifiedClassic(payload,label,btn,outEl); btn.disabled=false; btn.innerHTML=old; return; }
    if(e.message==='__AUTH__'){ outEl.innerHTML=''; }
    else{ outEl.innerHTML='<div class="alert alert-error">We couldn\'t build this set just now — the AI can be slow at peak times. Please tap Generate again.</div>'; }
    btn.disabled=false; btn.innerHTML=old; return;
  }
  if(final && final.questions_added>0){ _renderGenResult(final,payload,label,btn,outEl); }
  else{ await _genVerifiedClassic(payload,label,btn,outEl); }
  btn.disabled=false; btn.innerHTML=old;
}
function doStartPmBook(){
  const i=document.getElementById('pmb-book').value;
  if(i===''||!_refBooks[i]) return alert('Please choose a reference book');
  const book=_refBooks[i], topic=document.getElementById('pmb-topic').value||'';
  genVerified({subject:book.subject, topic, book:book.book, num_questions:countVal('pmb-count'), difficulty:document.getElementById('pmb-difficulty').value, question_type:document.getElementById('pmb-qtype').value},
    book.book+(topic?(' — '+topic):' — all topics'), document.getElementById('btn-pmb'), document.getElementById('pmb-output'));
}
function doStartPmSubject(){
  const i=document.getElementById('pms-subject').value;
  if(i===''||!_subjects[i]) return alert('Please choose a subject');
  const sub=_subjects[i], topic=document.getElementById('pms-topic').value||'';
  genVerified({subject:sub.subject, topic, num_questions:countVal('pms-count'), difficulty:document.getElementById('pms-difficulty').value, question_type:document.getElementById('pms-qtype').value},
    sub.subject+(topic?(' — '+topic):' — all topics'), document.getElementById('btn-pms'), document.getElementById('pms-output'));
}
function doStartPmOwn(){
  const topic=document.getElementById('pmo-topic').value.trim();
  if(!topic) return alert('Please type a topic to practice');
  genVerified({subject:'', topic, num_questions:countVal('pmo-count'), difficulty:document.getElementById('pmo-difficulty').value, question_type:document.getElementById('pmo-qtype').value},
    topic, document.getElementById('btn-pmo'), document.getElementById('pmo-output'));
}
