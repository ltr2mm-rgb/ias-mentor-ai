async function _renderPdfInto(box, url, wrapW, opts){
  opts=opts||{};
  const pdf=await pdfjsLib.getDocument(url).promise;
  for(let p=1;p<=pdf.numPages;p++){
    const page=await pdf.getPage(p);
    const base=page.getViewport({scale:1});
    const scale=Math.max(0.5, Math.min(2.0, (wrapW-28)/base.width));
    const viewport=page.getViewport({scale});
    const pageEl=document.createElement('div');
    pageEl.className='pdfpage';
    pageEl.style.width=viewport.width+'px'; pageEl.style.height=viewport.height+'px';
    pageEl.dataset.ch=(opts.chapterIdx!=null?opts.chapterIdx:0);
    pageEl.dataset.pg=(p-1);
    const cv=document.createElement('canvas'); cv.width=viewport.width; cv.height=viewport.height;
    cv.style.width=viewport.width+'px'; cv.style.height=viewport.height+'px';
    pageEl.appendChild(cv);
    const hl=document.createElement('div'); hl.className='hl-layer'; pageEl.appendChild(hl);
    box.appendChild(pageEl);
    await page.render({canvasContext:cv.getContext('2d'), viewport}).promise;
    if(opts.annotate){
      try{
        const tc=await page.getTextContent();
        const tl=document.createElement('div'); tl.className='textLayer';
        tl.style.width=viewport.width+'px'; tl.style.height=viewport.height+'px';
        tl.style.setProperty('--scale-factor', scale);
        pageEl.appendChild(tl);
        await pdfjsLib.renderTextLayer({textContent:tc, container:tl, viewport, textDivs:[]}).promise;
      }catch(e){}
      _drawSavedHighlights(pageEl, +pageEl.dataset.ch, +pageEl.dataset.pg);
    }
  }
}
// Lazy PDF.js renderer for big full books: lay out page-sized placeholders, then
// paint each page onto a canvas only as it scrolls near view. Keeps memory bounded
// so a 600-page / 160 MB book opens fast and scrolls smoothly.
async function _renderPdfLazy(box, url, wrapW, opts){
  opts=opts||{};
  const chIdx=(opts.chapterIdx!=null?opts.chapterIdx:0);
  const pdf=await pdfjsLib.getDocument({url:url, disableStream:true, disableAutoFetch:true, rangeChunkSize:262144}).promise;
  const p1=await pdf.getPage(1);
  const b1=p1.getViewport({scale:1});
  const scale=Math.max(0.5, Math.min(2.0, ((wrapW||800)-28)/b1.width));
  const vp1=p1.getViewport({scale});
  if(typeof opts.onTotal==='function') opts.onTotal(pdf.numPages);
  const io=new IntersectionObserver((entries)=>{
    entries.forEach((e)=>{
      if(!e.isIntersecting) return;
      const pageEl=e.target;
      if(pageEl.dataset.rendered) return;
      pageEl.dataset.rendered='1'; io.unobserve(pageEl);
      (async()=>{
        try{
          const page=await pdf.getPage(+pageEl.dataset.p);
          const viewport=page.getViewport({scale});
          const cv=document.createElement('canvas'); cv.width=viewport.width; cv.height=viewport.height;
          cv.style.width=viewport.width+'px'; cv.style.height=viewport.height+'px';
          pageEl.innerHTML=''; pageEl.appendChild(cv);
          const hl=document.createElement('div'); hl.className='hl-layer'; pageEl.appendChild(hl);
          await page.render({canvasContext:cv.getContext('2d'), viewport}).promise;
          if(opts.annotate){
            try{
              const tc=await page.getTextContent();
              const tl=document.createElement('div'); tl.className='textLayer';
              tl.style.width=viewport.width+'px'; tl.style.height=viewport.height+'px';
              tl.style.setProperty('--scale-factor', scale);
              pageEl.appendChild(tl);
              await pdfjsLib.renderTextLayer({textContent:tc, container:tl, viewport, textDivs:[]}).promise;
            }catch(e){}
            try{ _drawSavedHighlights(pageEl, +pageEl.dataset.ch, +pageEl.dataset.pg); }catch(e){}
          }
        }catch(err){}
      })();
    });
  }, {root:box, rootMargin:'1400px 0px'});
  // "Genuinely seen" observer: a page counts only after it dwells in the real
  // viewport for ~0.45s — so a fast scrollbar drag to the end does NOT count pages.
  const _dwell={};
  const seenIo=new IntersectionObserver((entries)=>{
    entries.forEach((e)=>{
      const pnum=+e.target.dataset.p, el=e.target;
      if(e.isIntersecting){
        if(!_dwell[pnum]) _dwell[pnum]=setTimeout(()=>{ delete _dwell[pnum]; seenIo.unobserve(el); if(typeof opts.onSeen==='function') opts.onSeen(pnum); }, 450);
      } else if(_dwell[pnum]){ clearTimeout(_dwell[pnum]); delete _dwell[pnum]; }
    });
  }, {root:box, rootMargin:'0px', threshold:0.01});
  const frag=document.createDocumentFragment();
  for(let p=1;p<=pdf.numPages;p++){
    const pageEl=document.createElement('div'); pageEl.className='pdfpage';
    pageEl.style.width=vp1.width+'px'; pageEl.style.height=vp1.height+'px';
    pageEl.dataset.p=p; pageEl.dataset.ch=chIdx; pageEl.dataset.pg=(p-1);
    frag.appendChild(pageEl);
  }
  box.appendChild(frag);
  box.querySelectorAll('.pdfpage').forEach(el=>{ io.observe(el); seenIo.observe(el); });
  return pdf.numPages;
}
