  const t=_todayTask(key); if(t) t.done=on; renderTodayMission();
  try{ await api('/me/today/done','POST',{task_key:key,completed:on}); }catch(e){}
}
async function _todayMark(key){
  const t=_todayTask(key); if(t&&!t.done){ t.done=true; renderTodayMission(); try{await api('/me/today/done','POST',{task_key:key,completed:true});}catch(e){} }
}
async function startTodayTask(key,btn){
  const t=_todayTask(key); if(!t) return; const p=t.params||{}, old=btn.innerHTML;
  try{
    if(t.kind==='revise'){ showPanel('revision'); await _todayMark(key); return; }
    if(t.kind==='ca'){ showPanel('studyhub'); await _todayMark(key); return; }
    if(t.kind==='explain'){ showPanel('ai-explain'); await _todayMark(key); return; }
    if(t.kind==='mains'){ showPanel('pyq'); await _todayMark(key); return; }
    if(t.kind==='read'){ showPanel('studyhub'); await _todayMark(key); return; }
    if(t.kind==='subject_test'){
      btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Building…';
      const d=await api('/mock-tests/generate-verified/','POST',{subject:p.subject,topic:'',num_questions:p.count||25,difficulty:p.difficulty||'medium',question_type:'all',reuse:true});
      btn.disabled=false; btn.innerHTML=old;
      if(d&&d.mock_test_id){ await _todayMark(key); startTest(d.mock_test_id,d.title||t.title,d.duration_minutes||25);} else alert('Could not build right now — try again.');
      return;
    }
    if(t.kind==='csat'){
      btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Building…';
      const d=await api('/pyq/csat/start','POST',{area:p.area||'reasoning'});
      btn.disabled=false; btn.innerHTML=old;
      if(d&&d.mock_test_id){ await _todayMark(key); startTest(d.mock_test_id,d.title||t.title,d.duration_minutes||20);} return;
    }
    if(t.kind==='guided'){
      const gk=p.kind, gp=p.params||{};
      if(gk==='read'){ try{await initNcert();}catch(e){} const _gru=resolveBookPdf(gp.read_url,gp.book_key); if(_gru) openPdfReader(_gru,t.title||'Reading'); else showPanel('ncert'); await _todayMark(key); return; }
      btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Building…';
      let d;
      if(gk==='ncert_test') d=await api('/ncert/generate','POST',{book_key:gp.book_key,chapter:'',num_questions:25,difficulty:'medium',question_type:'all'});
      else if(gk==='subject_test') d=await api('/mock-tests/generate-verified/','POST',{subject:gp.subject,topic:'',num_questions:25,difficulty:'medium',question_type:'all',reuse:true});
      else if(gk==='pyq') d=await api('/mock-tests/previous-year/','POST',{subject:gp.subject||'',year:'',num_questions:25});
      btn.disabled=false; btn.innerHTML=old;
      if(d&&d.mock_test_id){ await _todayMark(key); startTest(d.mock_test_id,d.title||t.title,d.duration_minutes||25);} else { showPanel('program'); await _todayMark(key);} return;
    }
    showPanel('program');
  }catch(e){ btn.disabled=false; btn.innerHTML=old; alert(emsg(e)); }
}
