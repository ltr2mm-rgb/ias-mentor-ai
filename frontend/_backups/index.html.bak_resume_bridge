  <iframe id="mc-frame" title="AI Marga Mission Control" style="width:100%;height:calc(100vh - 64px);border:0;display:block;background:#F8F4EC"></iframe>
</div>
<script>
window.openMarga=function(){
  try{var f=document.getElementById("mc-frame");if(f){var base="/mission-control?embed=1";
    if((f.getAttribute("src")||"").indexOf("/mission-control")<0){f.src=base;}else{f.src=base+"&t="+Date.now();}}}catch(e){}
  try{showPanel("marga");}catch(e){}
};
</script>

