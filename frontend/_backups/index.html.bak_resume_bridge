function parseCsatPaper(raw){
  const lines=(raw||'').replace(/\r/g,'').split('\n');
  let year=null; const passages=[]; const questions=[]; let cur=null; let i=0;
  const qRe=/^\s*Q\s*(\d+)\s*(?:[\|\(]\s*([A-Za-z0-9_]+)\s*\)?)?\s*[:.\-]?\s*(.*)$/i;
  const optRe=/^\s*[\(\[]?\s*([A-Da-d])\s*[\)\].:\-]\s+(.*)$/;
  const ansRe=/^\s*ANS(?:WER)?\s*[:\-]\s*([A-Da-d])/i;
  while(i<lines.length){
    const t=lines[i].trim();
    if(/^YEAR\s*[:\-]/i.test(t)){ year=parseInt((t.match(/\d{4}/)||[])[0]||''); i++; continue; }
    const pm=t.match(/^\[PASSAGE\s+([A-Za-z0-9_]+)\]\s*$/i);
    if(pm){ i++; const buf=[]; while(i<lines.length && !/^\[(END|\/PASSAGE)\]\s*$/i.test(lines[i].trim())){ buf.push(lines[i]); i++; } if(i<lines.length)i++; passages.push({id:pm[1], text:buf.join('\n').trim()}); continue; }
    const qm=t.match(qRe);
    if(qm){ if(cur) questions.push(cur); cur={q_no:parseInt(qm[1]),passage_id:qm[2]||null,text:(qm[3]||'').trim(),option_a:'',option_b:'',option_c:'',option_d:'',correct_answer:'',type:'general'}; i++; continue; }
    const am=t.match(ansRe); if(am&&cur){ cur.correct_answer=am[1].toUpperCase(); i++; continue; }
    const om=t.match(optRe); if(om&&cur){ cur['option_'+om[1].toLowerCase()]=om[2].trim(); i++; continue; }
    if(cur&&t&&!cur.option_a){ cur.text=(cur.text?cur.text+' ':'')+t; }
    i++;
  }
  if(cur) questions.push(cur);
  return {year,passages,questions};
}
function _validateCsat(p){
  const errs=[]; const pids=new Set(p.passages.map(x=>x.id));
  if(!p.year) errs.push('Missing "YEAR:" line (a 4-digit year).');
  if(!p.questions.length) errs.push('No questions detected — check the Q1 / A) / ANS: format.');
  p.questions.forEach(q=>{
    if(!q.option_a||!q.option_b||!q.option_c||!q.option_d) errs.push('Q'+q.q_no+': one or more options missing.');
    if(!/^[A-D]$/.test(q.correct_answer)) errs.push('Q'+q.q_no+': missing/invalid "ANS:" (must be A-D).');
    if(q.passage_id && !pids.has(q.passage_id)) errs.push('Q'+q.q_no+': passage "'+q.passage_id+'" is not defined.');
  });
  return errs;
}
