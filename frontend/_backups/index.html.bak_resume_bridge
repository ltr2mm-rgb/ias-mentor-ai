// ── LEARNING LOOP: Mistakes · Revision · Weak Areas ───────────────────────────
const REASON_LABELS={conceptual:'🧠 Conceptual gap',factual:'📌 Factual slip',careless:'⚡ Careless',misread:'👓 Misread',guess:'🎲 Guess',review:'🔍 Needs review'};
let mistakesCache=[];
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

let mistakeFilter={subject:null,reason:null,confidence:null,resolved:false,search:''};
async function loadMistakes(subject){
  if(subject!==undefined) mistakeFilter.subject=subject||null;
  const f=mistakeFilter;
  const list=document.getElementById('mistakes-list');
  list.innerHTML='<div class="empty"><div class="spinner"></div></div>';
  try{
    const qs=[];
    if(f.subject) qs.push('subject='+encodeURIComponent(f.subject));
    if(f.reason) qs.push('reason='+encodeURIComponent(f.reason));
    if(f.confidence) qs.push('confidence='+encodeURIComponent(f.confidence));
    if(f.resolved) qs.push('include_resolved=true');
    const d=await api('/me/mistakes'+(qs.length?('?'+qs.join('&')):''));
    mistakesCache=d.mistakes||[];
    renderMistakeFilters(d);
    rerenderMistakes(d);
  }catch(e){ list.innerHTML=`<div class="alert alert-error">${emsg(e)}</div>`; }
}
function rerenderMistakes(d){
  const list=document.getElementById('mistakes-list');
  let items=mistakesCache;
  const s=(mistakeFilter.search||'').toLowerCase();
  if(s) items=items.filter(m=>(m.question_text||'').toLowerCase().includes(s));
  if(!items.length){ list.innerHTML='<div class="empty"><div class="empty-icon">📕</div><p>No mistakes match.<br>'+((d&&d.count)?'Try clearing filters.':'Take a test — anything you miss lands here automatically.')+'</p></div>'; return; }
  list.innerHTML=items.map(renderMistake).join('');
}
function renderMistakeFilters(d){
  const fc=document.getElementById('mistakes-filter'); if(!fc) return;
  const f=mistakeFilter;
  const subjChips=[`<button class="btn btn-sm ${!f.subject?'btn-primary':'btn-secondary'}" onclick="setMistakeFilter('subject',null)">All (${d.count})</button>`]
    .concat((d.by_subject||[]).map(s=>`<button class="btn btn-sm ${f.subject===s.subject?'btn-primary':'btn-secondary'}" onclick="setMistakeFilter('subject','${s.subject.replace(/'/g,"\\'")}')">${esc(s.subject)} (${s.count})</button>`)).join('');
  const reasons=['conceptual','factual','careless','misread','guess'];
  const reasonChips=reasons.map(r=>`<button class="conf-btn ${f.reason===r?'active':''}" onclick="setMistakeFilter('reason','${r}')">${REASON_LABELS[r]}</button>`).join('');
  const confs=['sure','unsure','guess'];
  const confChips=confs.map(c=>`<button class="conf-btn ${f.confidence===c?'active':''}" onclick="setMistakeFilter('confidence','${c}')">${c}</button>`).join('');
  fc.innerHTML=`<div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.5rem">${subjChips}</div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-bottom:0.4rem">
      <span style="font-size:0.74rem;color:var(--muted)">Why:</span>${reasonChips}
      <span style="font-size:0.74rem;color:var(--muted);margin-left:0.4rem">Confidence:</span>${confChips}
    </div>
    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center">
      <input id="mistake-search" placeholder="🔎 Search questions..." value="${esc(f.search)}" oninput="mistakeFilter.search=this.value;rerenderMistakes()" style="flex:1;min-width:180px">
      <label style="font-size:0.8rem;color:var(--muted);display:flex;align-items:center;gap:0.35rem;cursor:pointer"><input type="checkbox" ${f.resolved?'checked':''} onchange="mistakeFilter.resolved=this.checked;loadMistakes()"> show resolved${d.resolved_total?` (${d.resolved_total})`:''}</label>
    </div>`;
}
function setMistakeFilter(key,val){ mistakeFilter[key]=(mistakeFilter[key]===val?null:val); loadMistakes(); }
function renderMistake(m){
  const opts=['A','B','C','D'].map(l=>{
    const cls=l===m.correct_answer?'correct':(l===m.your_answer?'wrong':'');
    const tag=l===m.correct_answer?' ✓':(l===m.your_answer?' ✗ you':'');
    return `<div class="opt ${cls}"><div class="opt-letter">${l}</div><div>${esc(m.options[l]||'')}${tag}</div></div>`;
  }).join('');
  const reasons=['conceptual','factual','careless','misread','guess'];
  const chips=reasons.map(r=>`<button class="conf-btn ${m.reason===r?'active':''}" onclick="tagReason(${m.answer_id},'${r}',this)">${REASON_LABELS[r]}</button>`).join('');
  const auto=m.reason_is_auto?`<span style="font-size:0.72rem;color:var(--muted)">auto-tagged: ${REASON_LABELS[m.reason]||m.reason} · confirm or change ↓</span>`:'';
  const comm=(m.community_accuracy!=null&&m.community_attempts>=3)?`<span class="badge" title="How often this is answered correctly overall">🌍 ${m.community_accuracy}% get it right</span>`:'';
  return `<div class="q-card" id="mk-${m.question_id}" style="${m.resolved?'opacity:0.6':''}">
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.5rem;align-items:center">
      <span class="badge badge-blue">${esc(m.subject)}</span>
      ${m.topic?`<span class="badge">${esc(m.topic)}</span>`:''}
      ${m.confidence?`<span class="badge ${m.confidence==='sure'?'badge-red':''}">was ${m.confidence}</span>`:''}
      ${comm}
      ${m.resolved?'<span class="badge badge-green">✓ resolved</span>':''}
    </div>
    <div class="q-text">${esc(m.question_text).replace(/\n/g,'<br>')}</div>
    <div class="options" style="pointer-events:none">${opts}</div>
    ${m.explanation?`<div class="explanation">💡 <strong>Explanation:</strong> ${esc(m.explanation).replace(/\n/g,'<br>')}</div>`:''}
    <div style="margin-top:0.8rem">
      <div style="font-size:0.78rem;color:var(--muted);margin-bottom:0.35rem">Tag why you missed it: ${auto}</div>
      <div style="display:flex;gap:0.4rem;flex-wrap:wrap">${chips}</div>
    </div>
    <div style="margin-top:0.8rem;display:flex;gap:0.4rem;flex-wrap:wrap">
      <button class="btn btn-secondary btn-sm" onclick="diagnoseMistake(${m.question_id},this)">🤖 Why wrong?</button>
      <button class="btn btn-secondary btn-sm" onclick="reviseMistake(${m.question_id},this)">🔁 Add to revision</button>
      <button class="btn btn-secondary btn-sm" onclick="toggleBookmark(${m.question_id},this)" style="${m.bookmarked?'color:var(--accent)':''}">${m.bookmarked?'★ Saved':'☆ Bookmark'}</button>
      <button class="btn btn-secondary btn-sm" onclick="resolveMistake(${m.question_id},this)">${m.resolved?'↩ Unresolve':'✓ Mark resolved'}</button>
      <button class="btn btn-secondary btn-sm" onclick="flagQuestion(${m.question_id},this)">🚩 Flag</button>
    </div>
    <div id="diag-${m.question_id}"></div>
  </div>`;
}
async function reviseMistake(qid,btn){
  const o=btn.innerHTML; btn.disabled=true; btn.innerHTML='Adding...';
  try{ await api(`/me/mistakes/${qid}/revise`,'POST'); btn.innerHTML='✓ In revision'; refreshLearningCards(); }
  catch(e){ btn.disabled=false; btn.innerHTML=o; alert(emsg(e)); }
}
async function resolveMistake(qid,btn){
  try{ const d=await api(`/me/mistakes/${qid}/resolve`,'POST');
    const card=document.getElementById('mk-'+qid);
    if(d.resolved){ btn.innerHTML='↩ Unresolve'; if(card){ if(mistakeFilter.resolved){ card.style.opacity='0.6'; } else { card.remove(); } } }
    else { btn.innerHTML='✓ Mark resolved'; if(card) card.style.opacity='1'; }
  }catch(e){ alert(emsg(e)); }
}
async function diagnoseMistake(qid,btn){
  const out=document.getElementById('diag-'+qid);
  const old=btn.innerHTML; btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Analysing...';
  try{
    const d=await api(`/me/mistakes/${qid}/diagnose`,'POST');
    out.innerHTML=`<div class="explanation" style="border-left-color:var(--accent);margin-top:0.6rem">${mdToHtml(d.diagnosis||'')}</div>`;
    btn.style.display='none';
  }catch(e){ out.innerHTML=`<div class="alert alert-error" style="margin-top:0.6rem">${emsg(e)}</div>`; btn.disabled=false; btn.innerHTML=old; }
}
async function tagReason(answerId,reason,btn){
  const row=btn.parentElement;
  row.querySelectorAll('.conf-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  try{ await api(`/me/mistakes/${answerId}/reason`,'PUT',{reason}); }catch(e){}
}

