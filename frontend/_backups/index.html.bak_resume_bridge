(function(){
  var h=document.getElementById('mentor-resize'); if(!h) return;
  var drag=false;
  function clampW(w){ return Math.max(300, Math.min(w, Math.round(window.innerWidth*0.7))); }
  function setW(w){ w=clampW(w); document.documentElement.style.setProperty('--dock-w', w+'px'); try{ localStorage.setItem('mentor_dock_w', w); }catch(e){} }
  function move(e){ if(!drag) return; var x=e.touches?e.touches[0].clientX:e.clientX; setW(window.innerWidth - x); if(e.cancelable) e.preventDefault(); }
  function up(){ drag=false; document.body.style.userSelect=''; }
  h.addEventListener('mousedown', function(e){ drag=true; document.body.style.userSelect='none'; e.preventDefault(); });
  h.addEventListener('touchstart', function(){ drag=true; }, {passive:true});
  document.addEventListener('mousemove', move);
  document.addEventListener('touchmove', move, {passive:false});
  document.addEventListener('mouseup', up);
  document.addEventListener('touchend', up);
  try{ var sw=localStorage.getItem('mentor_dock_w'); if(sw) document.documentElement.style.setProperty('--dock-w', clampW(parseInt(sw,10))+'px'); }catch(e){}
})();

