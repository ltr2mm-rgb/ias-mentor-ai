function _sylSecDone(sec){ return sec.topics.filter(t=>_sylDone.has(t.id)).length; }
function renderSyllabus(){
  const box=document.getElementById('syllabus-tree');
  let html='';
  _sylTree.forEach((stage,si)=>{
    const sdone=stage.papers.reduce((a,p)=>a+p.sections.reduce((b,s)=>b+_sylSecDone(s),0),0);
    html+=`<div style="font-weight:800;font-size:1.05rem;margin:1.1rem 0 0.6rem">${esc(stage.stage)} <span id="sylcnt-${stage.id}" style="color:var(--muted);font-weight:500;font-size:0.82rem">${sdone}/${stage.total}</span></div>`;
    stage.papers.forEach((p,pi)=>{
      const pdone=p.sections.reduce((b,s)=>b+_sylSecDone(s),0);
      const pPct=p.total?Math.round(100*pdone/p.total):0;
      // Lazy: only the summary renders now; topics render on first expand.
      html+=`<details class="card" style="margin-bottom:0.6rem" ontoggle="if(this.open)renderSyllabusPaper(${si},${pi})">
        <summary style="cursor:pointer;font-weight:600;display:flex;align-items:center;gap:0.5rem">
          <span>${esc(p.paper)}</span>
          <span id="sylcnt-${p.id}" style="margin-left:auto;color:var(--muted);font-size:0.8rem">${pdone}/${p.total} · ${pPct}%</span>
        </summary>
        <div class="syl-body" id="sylbody-${p.id}" style="margin-top:0.7rem"><div class="empty" style="padding:0.6rem">Loading…</div></div>
      </details>`;
    });
  });
  box.innerHTML=html;
  updateSyllabusProgress();
}
function renderSyllabusPaper(si,pi){
  const p=_sylTree[si] && _sylTree[si].papers[pi];
  const body=document.getElementById('sylbody-'+si+'.'+pi);
  if(!p || !body || body.dataset.loaded) return;
  let html='';
  p.sections.forEach(sec=>{
    const cdone=_sylSecDone(sec);
    html+=`<div style="margin:0.7rem 0 0.2rem;font-weight:600;font-size:0.9rem;color:var(--accent)">${esc(sec.section)} <span id="sylcnt-${sec.id}" style="color:var(--muted);font-weight:500;font-size:0.78rem">(${cdone}/${sec.total})</span></div>`;
    html+=sec.topics.map(t=>{
      const on=_sylDone.has(t.id);
      return `<label class="syltopic">
        <input type="checkbox" ${on?'checked':''} onchange="toggleSyllabusTopic('${t.id}',this)">
        <span class="${on?'done':''}">${esc(t.label)}</span></label>`;
    }).join('');
  });
  body.innerHTML=html;
  body.dataset.loaded='1';
}
function updateSyllabusProgress(){
  const done=_sylDone.size, total=_sylTotal||1;
  const pct=Math.round(100*done/total);
  document.getElementById('syl-bar').style.width=pct+'%';
  document.getElementById('syl-pct').textContent=pct+'%';
  document.getElementById('syl-count').textContent=`(${done} / ${_sylTotal} topics)`;
}
function updateSyllabusCounts(id){
  const parts=id.split('.'); const si=+parts[0], pi=+parts[1], ci=+parts[2];
  const stage=_sylTree[si], paper=stage.papers[pi], sec=paper.sections[ci];
  const cdone=_sylSecDone(sec);
  const pdone=paper.sections.reduce((a,s)=>a+_sylSecDone(s),0);
  const sdone=stage.papers.reduce((a,pp)=>a+pp.sections.reduce((b,s)=>b+_sylSecDone(s),0),0);
  const setT=(eid,txt)=>{const e=document.getElementById('sylcnt-'+eid);if(e)e.textContent=txt;};
  setT(sec.id, `(${cdone}/${sec.total})`);
  setT(paper.id, `${pdone}/${paper.total} · ${paper.total?Math.round(100*pdone/paper.total):0}%`);
  setT(stage.id, `${sdone}/${stage.total}`);
}
async function toggleSyllabusTopic(id, el){
  const on=el.checked;
  if(on) _sylDone.add(id); else _sylDone.delete(id);
  const span=el.parentElement.querySelector('span');
  if(span) span.classList.toggle('done', on);
  updateSyllabusProgress(); updateSyllabusCounts(id);
  try{ await api('/me/syllabus/toggle','POST',{topic_id:id,completed:on}); }
  catch(e){
    // revert UI on failure
    el.checked=!on; if(on)_sylDone.delete(id); else _sylDone.add(id);
    if(span) span.classList.toggle('done', el.checked);
    updateSyllabusProgress(); updateSyllabusCounts(id);
  }
}
async function resetSyllabus(){
  if(!confirm('Reset all syllabus progress? This cannot be undone.')) return;
  try{ await api('/me/syllabus/reset','POST',{}); _sylDone=new Set(); renderSyllabus(); }
  catch(e){ alert(emsg(e)); }
}

