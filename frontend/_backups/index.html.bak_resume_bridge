function _sparkline(series, key, w, h){
  const vals=series.map(s=>s[key]||0); const max=Math.max(1,...vals);
  const n=series.length, gap=w/(n-1||1);
  const pts=vals.map((v,i)=>`${(i*gap).toFixed(1)},${(h-6-(v/max)*(h-12)).toFixed(1)}`).join(' ');
  const dots=vals.map((v,i)=>`<circle cx="${(i*gap).toFixed(1)}" cy="${(h-6-(v/max)*(h-12)).toFixed(1)}" r="2.5" fill="var(--accent)"/>`).join('');
  return `<svg width="100%" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="display:block"><polyline points="${pts}" fill="none" stroke="var(--accent)" stroke-width="2"/>${dots}</svg>`;
}
function _bars(series, key, w, h){
  const vals=series.map(s=>s[key]||0); const max=Math.max(1,...vals);
  const n=series.length, bw=w/n*0.65, gap=w/n;
  return `<svg width="100%" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="display:block">${vals.map((v,i)=>{const bh=(v/max)*(h-8);return `<rect x="${(i*gap+gap*0.17).toFixed(1)}" y="${(h-bh).toFixed(1)}" width="${bw.toFixed(1)}" height="${bh.toFixed(1)}" rx="1.5" fill="${v?'var(--accent)':'rgba(0,0,0,0.07)'}"/>`;}).join('')}</svg>`;
}
