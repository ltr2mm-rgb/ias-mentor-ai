// ── Export notes to PDF (client-side, jsPDF) ──────────────────────────────────
let _jspdfReady=null;
function _ensureJsPdf(){
  if(window.jspdf&&window.jspdf.jsPDF) return Promise.resolve();
  if(_jspdfReady) return _jspdfReady;
  _jspdfReady=new Promise((res,rej)=>{
    const s=document.createElement('script');
    s.src='https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
    s.onload=res; s.onerror=()=>rej(new Error('Could not load the PDF library.'));
    document.head.appendChild(s);
  });
  return _jspdfReady;
}
function _filteredNotes(){
  const q=(_notesFilter.q||'').trim().toLowerCase();
  return _allNotes.filter(n=>{
    if(_notesFilter.book && n.book_key!==_notesFilter.book) return false;
    if(_notesFilter.type && n.kind!==_notesFilter.type) return false;
    if(_notesFilter.label && (n.label||'')!==_notesFilter.label) return false;
    if(q && !((n.text||'').toLowerCase().includes(q) || (n.book||'').toLowerCase().includes(q) || (n.chapter||'').toLowerCase().includes(q))) return false;
    return true;
  });
}
async function exportNotesPdf(){
  const notes=_filteredNotes();
  if(!notes.length){ alert('Nothing to export with the current filters.'); return; }
  try{ await _ensureJsPdf(); }catch(e){ alert(emsg(e)); return; }
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({unit:'pt', format:'a4'});
  const M=48, W=doc.internal.pageSize.getWidth(), H=doc.internal.pageSize.getHeight();
  let y=M;
  const nl=(dy)=>{ y+=dy; if(y>H-M){ doc.addPage(); y=M; } };
  // title
  doc.setFont('helvetica','bold'); doc.setFontSize(18);
  doc.text('AIMENTORA — My Notes & Highlights', M, y); nl(24);
  doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(120);
  doc.text(notes.length+' item'+(notes.length!==1?'s':'')+'  ·  exported '+new Date().toLocaleDateString(), M, y);
  doc.setTextColor(20); nl(26);
  // group book -> chapter (mirrors the on-screen grouping)
  const books={};
  notes.forEach(n=>{ const bk=books[n.book_key]||(books[n.book_key]={book:n.book, chapters:{}});
    (bk.chapters[n.chapter_index]||(bk.chapters[n.chapter_index]={ch:n.chapter, idx:n.chapter_index, items:[]})).items.push(n); });
  Object.values(books).forEach(bk=>{
    if(y>H-M-40){ doc.addPage(); y=M; }
    doc.setFont('helvetica','bold'); doc.setFontSize(13); doc.text(bk.book||'', M, y); nl(18);
    Object.values(bk.chapters).sort((a,b)=>a.idx-b.idx).forEach(cp=>{
      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(80);
      const chLines=doc.splitTextToSize(cp.ch||('Chapter '+(cp.idx+1)), W-2*M);
      chLines.forEach(l=>{ doc.text(l, M, y); nl(15); });
      doc.setTextColor(20);
      cp.items.forEach(n=>{
        const mark=n.kind==='highlight'?'[H]':'[N]';
        const lbl=n.label?(' ['+n.label+']'):'';
        doc.setFont('helvetica','normal'); doc.setFontSize(10.5);
        const lines=doc.splitTextToSize(mark+lbl+'  '+(n.text||''), W-2*M-10);
        lines.forEach(l=>{ if(y>H-M){ doc.addPage(); y=M; } doc.text(l, M+10, y); y+=14; });
        nl(4);
      });
      nl(6);
    });
    nl(8);
  });
  const bkName=(_notesFilter.book&&(_allNotes.find(n=>n.book_key===_notesFilter.book)||{}).book)||'all-books';
  const safe=(bkName||'notes').replace(/[^a-z0-9]+/gi,'-').toLowerCase().slice(0,40);
  doc.save('aivora-notes-'+safe+'.pdf');
}
